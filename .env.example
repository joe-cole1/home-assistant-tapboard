# Home Assistant Configuration
HA_URL=http://192.168.1.100:8123
HA_TOKEN=your_long_lived_access_token_here

# Server Configuration
PORT=3000

# Leave blank for direct HTTP access. Set to the exact external HTTPS origin
# when a reverse proxy terminates TLS, for example https://tapboard.example.com.
TAPBOARD_PUBLIC_ORIGIN=

# Set false only for the very first start of a genuinely new installation.
# Existing installations should remain true so an empty volume fails closed.
TAPBOARD_EXPECT_EXISTING_DATA=false

# First-run / legacy-default migration only. Uncomment, choose four digits other
# than 0000, start Tapboard once, then remove it and recreate the container.
# TAPBOARD_INITIAL_ADMIN_PIN=<choose-four-digits>
