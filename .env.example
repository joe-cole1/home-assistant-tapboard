# v2 self-hosted operator reference. Copy this file to the ignored .env file.
# Keep the generated secret only in .env; never commit that file.

TAPBOARD_HOST=127.0.0.1
TAPBOARD_PORT=3000
TAPBOARD_DATABASE_PATH=data/tapboard-v2.sqlite3
TAPBOARD_SHUTDOWN_GRACE_MS=5000
TAPBOARD_SESSION_INACTIVITY_MS=2592000000
TAPBOARD_SESSION_ABSOLUTE_MS=31536000000

# Reverse-proxy/origin settings (optional; leave unset for direct local access).
# TAPBOARD_EXTERNAL_ORIGIN=
# TAPBOARD_TRUSTED_PROXIES=

# Replace this obvious placeholder in .env with a generated 32-byte base64url key.
TAPBOARD_SECRET_KEY=REPLACE_WITH_GENERATED_BASE64URL_KEY
# Generate a key with:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n='
