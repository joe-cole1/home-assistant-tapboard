<%
  const pickerOptions = Array.isArray(it.options) ? it.options : [];
  const selected = typeof it.selected === "string" ? it.selected : "";
  const selectedOption = pickerOptions.find((option) => option.id === selected);
  const selectedLabel = selectedOption?.label || "None (style suggestion)";
  const pickerId = String(it.id || "fill-glass").replace(/[^a-zA-Z0-9_-]/gu, "-");
  const color = "#D97706";
%>
<details id="<%= pickerId %>" class="fill-glass-picker">
  <summary>
    <span><%= it.label || "Fill Glass" %></span>
    <span class="fill-glass-picker__current">
      <% if (selectedOption) { const graphic = selectedOption.graphic;  %>
        <span class="fill-glass-picker__graphic fill-glass-picker__graphic--current" aria-hidden="true">
          <%~ include("/partials/fill-graphic", { tap: { id: `${pickerId}-selected`, graphic, fillPercent: 72, displayColor: color, title: selectedLabel } }) %>
        </span>
      <% } %>
      <span><%= selectedLabel %></span>
    </span>
  </summary>
  <fieldset id="<%= pickerId %>-options">
    <legend>Choose a catalog vessel</legend>
    <label class="fill-glass-picker__option">
      <input type="radio" name="<%= it.name || "fillGlass" %>" value=""<% if (selected === "") { %> checked<% } %> />
      <span class="fill-glass-picker__copy"><strong>None</strong><small>Use style suggestion</small></span>
    </label>
    <% for (const option of pickerOptions) { const graphic = option.graphic;  %>
      <label class="fill-glass-picker__option">
        <input type="radio" name="<%= it.name || "fillGlass" %>" value="<%= option.id %>"<% if (selected === option.id) { %> checked<% } %> />
        <span class="fill-glass-picker__copy">
          <span class="fill-glass-picker__graphic" aria-hidden="true">
            <%~ include("/partials/fill-graphic", { tap: { id: `${pickerId}-${option.id}`, graphic, fillPercent: 72, displayColor: color, title: option.label } }) %>
          </span>
          <strong><%= option.label %></strong>
        </span>
      </label>
    <% } %>
  </fieldset>
</details>
