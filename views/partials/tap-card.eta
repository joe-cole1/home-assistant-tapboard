<% const metric = it.sharedDisplay.unitSystem === "metric"; const volume = (ml) => metric ? ((ml / 1000).toFixed(1) + " L") : ((ml / 3785.411784).toFixed(1) + " gal"); const temperature = (c) => metric ? (c.toFixed(1) + " °C") : ((c * 9 / 5 + 32).toFixed(1) + " °F"); %>
<article class="tap-card" data-tap-id="<%= it.tap.id %>" data-tap-number="<%= it.tap.tapNumber %>" data-health="<%= it.tap.health %>"<% if (typeof it.tap.fillPercent === "number") { %> data-fill-percent="<%= it.tap.fillPercent %>"<% } %><% if (typeof it.tap.temperatureC === "number") { %> data-temperature-c="<%= it.tap.temperatureC %>"<% } %><% if (typeof it.tap.remainingVolumeMl === "number") { %> data-remaining-volume-ml="<%= it.tap.remainingVolumeMl %>"<% } %><% if (typeof it.tap.capacityMl === "number") { %> data-capacity-ml="<%= it.tap.capacityMl %>"<% } %>>
  <div class="tap-copy"><p class="tap-number" data-field="tap-number">Tap <%= it.tap.tapNumber %></p><h2 data-field="tap-name"><%= it.tap.tapName || it.tap.beverageName || ("Tap " + it.tap.tapNumber) %></h2>
  <p class="beverage-name" data-field="beverage-name"><%= it.tap.beverageName || "Unassigned" %></p>
  <p class="meta" data-field="style"<% if (!it.tap.style) { %> hidden<% } %>><%= it.tap.style || "" %></p><p class="meta" data-field="abv"<% if (typeof it.tap.abv !== "number") { %> hidden<% } %>><%= typeof it.tap.abv === "number" ? (it.tap.abv + "% ABV") : "" %></p>
  <p class="description" data-field="description"<% if (!it.tap.description) { %> hidden<% } %>><%= it.tap.description || "" %></p>
  <p class="status" data-field="forecast"><% if (it.tap.waitingForMeasurement) { %>Waiting for measurement<% } else if (typeof it.tap.servingsRemaining === "number" || typeof it.tap.daysRemaining === "number") { %><%= typeof it.tap.servingsRemaining === "number" ? (it.tap.servingsRemaining + " servings") : "" %><%= typeof it.tap.daysRemaining === "number" ? ((typeof it.tap.servingsRemaining === "number" ? " · " : "") + it.tap.daysRemaining + " days") : "" %><% } else { %>Measurement unavailable<% } %></p>
  <p class="temperature" data-field="temperature"<% if (typeof it.tap.temperatureC !== "number") { %> hidden<% } %>><%= typeof it.tap.temperatureC === "number" ? temperature(it.tap.temperatureC) : "" %></p></div><div class="tap-visual"><%~ include("/partials/fill-graphic", { tap: it.tap }) %><p class="volume" data-field="volume"<% if (typeof it.tap.remainingVolumeMl !== "number" || typeof it.tap.capacityMl !== "number") { %> hidden<% } %>><%= typeof it.tap.remainingVolumeMl === "number" && typeof it.tap.capacityMl === "number" ? (volume(it.tap.remainingVolumeMl) + " / " + volume(it.tap.capacityMl)) : "" %></p></div>
</article>
