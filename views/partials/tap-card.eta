<%
  const number = (value) => typeof value === "number" && Number.isFinite(value);
  const volume = (ml, unit) => unit === "metric" ? ((ml / 1000).toFixed(1) + " L") : ((ml / 3785.411784).toFixed(1) + " gal");
  const temperature = (c, unit) => unit === "metric" ? (c.toFixed(1) + " °C") : ((c * 9 / 5 + 32).toFixed(1) + " °F");
  const readout = (tap, mode, unit) => {
    if (tap.waitingForMeasurement) return "Waiting for measurement";
    if (mode === "percent" && number(tap.fillPercent)) return Math.round(tap.fillPercent) + "% remaining";
    if (mode === "pints" && number(tap.remainingVolumeMl)) return (tap.remainingVolumeMl / 473.176473).toFixed(1) + " pints remaining";
    if (mode === "pours" && number(tap.servingsRemaining)) return Math.max(0, Math.floor(tap.servingsRemaining)) + " pours remaining";
    if (mode === "volume" && number(tap.remainingVolumeMl) && number(tap.capacityMl)) return volume(tap.remainingVolumeMl, unit) + " / " + volume(tap.capacityMl, unit);
    return "Measurement unavailable";
  };
  const forecast = (tap) => ({
    servings: !tap.waitingForMeasurement && number(tap.servingsRemaining) ? Math.max(0, Math.floor(tap.servingsRemaining)) + " servings" : "",
    days: !tap.waitingForMeasurement && number(tap.daysRemaining) ? tap.daysRemaining + " days" : "",
    status: tap.waitingForMeasurement ? "Waiting for measurement" : !number(tap.servingsRemaining) && !number(tap.daysRemaining) ? "Measurement unavailable" : "",
  });
  const forecastValues = forecast(it.tap);
  const story = typeof it.tap.storyPath === "string" && it.tap.storyPath.startsWith("/taps/");
  const title = it.tap.title || it.tap.beverageName || "Empty Tap";
  const healthLabel = it.tap.health === "healthy" ? "Healthy" : it.tap.health === "degraded" ? "Degraded" : "Unknown";
  const abvMetric = (it.tap.metrics || []).find((metric) => metric.key === "abv");
  const visibleMetrics = (it.tap.metrics || []).filter((metric) => metric.key !== "abv");
  const styleLine = [abvMetric?.value, it.tap.style].filter(Boolean).join(" · ");
  const cardAccessibleLabel = it.tap.accessibleLabel || (story ? title + " story" : "Tap " + it.tap.tapNumber + ", " + title);
%>
<% if (story) { %><a class="tap-card" data-tap-id="<%= it.tap.id %>" data-tap-number="<%= it.tap.tapNumber %>" data-health="<%= it.tap.health %>" data-waiting-for-measurement="<%= it.tap.waitingForMeasurement === true %>"<% if (it.adminPourPreview === true) { %> data-admin-pour-preview="true" aria-keyshortcuts="Shift+Space"<% } %> href="<%= it.tap.storyPath %>" aria-label="<%= it.tap.accessibleLabel || (title + " story") %>"<% if (number(it.tap.fillPercent)) { %> data-fill-percent="<%= it.tap.fillPercent %>"<% } %><% if (number(it.tap.temperatureC)) { %> data-temperature-c="<%= it.tap.temperatureC %>"<% } %><% if (number(it.tap.remainingVolumeMl)) { %> data-remaining-volume-ml="<%= it.tap.remainingVolumeMl %>"<% } %><% if (number(it.tap.capacityMl)) { %> data-capacity-ml="<%= it.tap.capacityMl %>"<% } %><% if (number(it.tap.servingsRemaining)) { %> data-servings-remaining="<%= it.tap.servingsRemaining %>"<% } %>>
<% } else { %><article class="tap-card" data-tap-id="<%= it.tap.id %>" data-tap-number="<%= it.tap.tapNumber %>" data-health="<%= it.tap.health %>" data-waiting-for-measurement="<%= it.tap.waitingForMeasurement === true %>" tabindex="0"<% if (it.adminPourPreview === true) { %> data-admin-pour-preview="true" aria-keyshortcuts="Shift+Space"<% } %> aria-label="<%= cardAccessibleLabel %>"<% if (number(it.tap.fillPercent)) { %> data-fill-percent="<%= it.tap.fillPercent %>"<% } %><% if (number(it.tap.temperatureC)) { %> data-temperature-c="<%= it.tap.temperatureC %>"<% } %><% if (number(it.tap.remainingVolumeMl)) { %> data-remaining-volume-ml="<%= it.tap.remainingVolumeMl %>"<% } %><% if (number(it.tap.capacityMl)) { %> data-capacity-ml="<%= it.tap.capacityMl %>"<% } %><% if (number(it.tap.servingsRemaining)) { %> data-servings-remaining="<%= it.tap.servingsRemaining %>"<% } %>>
<% } %>
  <div class="tap-title-row">
    <span class="tap-number-badge" aria-hidden="true" data-field="tap-number"><%= it.tap.tapNumber %></span>
    <h2 data-field="tap-name"><%= title %></h2>
  </div>
  <div class="tap-copy">
    <div class="tap-meta-row">
      <p class="meta tap-style-line" data-field="style-line"<% if (!styleLine) { %> hidden<% } %>><%= styleLine %></p>
    </div>
    <dl class="tap-metrics" data-field="metrics"<% if (visibleMetrics.length === 0) { %> hidden<% } %>>
      <% for (const metric of visibleMetrics) { %><div><dt><%= metric.label %></dt><dd><%= metric.value %></dd></div><% } %>
    </dl>
    <p class="description" data-field="description"<% if (!it.tap.description) { %> hidden<% } %>><%= it.tap.description || "" %></p>
    <p class="temperature" data-field="temperature"<% if (!number(it.tap.temperatureC)) { %> hidden<% } %>><span data-unit="metric"><%= number(it.tap.temperatureC) ? temperature(it.tap.temperatureC, "metric") : "" %></span><span data-unit="us"><%= number(it.tap.temperatureC) ? temperature(it.tap.temperatureC, "us") : "" %></span></p>
  </div>
  <div class="tap-visual">
    <%~ include("/partials/fill-graphic", { tap: it.tap }) %>
    <span class="pour-preview-status" data-pour-preview-status aria-live="polite" hidden>Now pouring</span>
    <p class="remaining-readout" data-field="remaining-readout"><%= readout(it.tap, it.sharedDisplay.remainingMode, it.sharedDisplay.unitSystem) %></p>
    <p class="forecast" data-field="forecast">
      <span data-field="forecast-servings"<% if (!forecastValues.servings) { %> hidden<% } %>><%= forecastValues.servings %></span>
      <span data-field="forecast-days"<% if (!forecastValues.days) { %> hidden<% } %>><%= forecastValues.days %></span>
      <span data-field="forecast-status"<% if (!forecastValues.status) { %> hidden<% } %>><%= forecastValues.status %></span>
    </p>
  </div>
  <div class="tap-badges"><span class="health-badge" data-field="health"><span class="health-dot" aria-hidden="true"></span><span data-field="health-label"><%= healthLabel %></span></span></div>
<% if (story) { %></a><% } else { %></article><% } %>
