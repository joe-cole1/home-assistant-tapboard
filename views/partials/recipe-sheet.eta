<% const recipe = it.recipe; const sheet = recipe.sheet; const stageLabels = { boil: "Boil", dry_hop: "Dry hop", whirlpool: "Whirlpool", first_wort: "First wort", mash: "Mash" }; %>
<article class="recipe-sheet" data-recipe-sheet>
  <header class="recipe-sheet-header">
    <h3><%= it.title %></h3>
    <p><%= recipe.kind === "custom" ? "Custom recipe" : recipe.provenance?.label || "Source recipe" %></p>
    <% if (recipe.status === "partial") { %><p>Some recipe details are incomplete or unavailable.</p><% } else if (recipe.status === "unavailable") { %><p>Recipe details are unavailable.</p><% } %>
    <% if (it.style) { %><p><%= it.style %></p><% } %>
    <% if (it.color !== null && it.color !== undefined) { %><p class="recipe-sheet-color"><%= it.recipeNumber(it.color) %> SRM</p><% } %>
  </header>
  <% if (recipe.notes) { %><p class="recipe-sheet-notes"><%= recipe.notes %></p><% } %>
  <% if (sheet) { %>
    <div class="recipe-sheet-columns">
      <div class="recipe-sheet-column">
        <section class="recipe-sheet-section" aria-label="Recipe targets">
          <h4>Recipe targets</h4>
          <dl>
            <% for (const [label, key, digits, suffix] of [["Original gravity", "og", 3, ""], ["Final gravity", "fg", 3, ""], ["ABV", "abv", 1, "%"], ["Bitterness", "ibu", 1, " IBU"], ["Color", "colorSrm", 1, " SRM"], ["Carbonation", "carbonationVolumes", 1, " CO₂ volumes"]]) { if (sheet.summary[key] !== null) { %><dt><%= label %></dt><dd><%= key === "og" || key === "fg" ? sheet.summary[key].toFixed(3) : it.recipeNumber(sheet.summary[key], digits) %><%= suffix %></dd><% } } %>
          </dl>
          <% if ([sheet.summary.og, sheet.summary.fg, sheet.summary.abv, sheet.summary.ibu, sheet.summary.colorSrm, sheet.summary.carbonationVolumes].every(value => value === null)) { %><p class="muted">Not recorded or unavailable.</p><% } %>
        </section>
        <% for (const [key, label, total] of [["fermentables", "Fermentables", sheet.totals.fermentablesGrams], ["hops", "Hops", sheet.totals.hopsGrams], ["miscs", "Miscellaneous", null], ["yeasts", "Yeast", null], ["other", "Other ingredients", null]]) { const rows = sheet.ingredients[key]; if (key !== "other" || rows.length > 0) { %>
          <section class="recipe-sheet-section" aria-label="<%= label %>">
            <h4><%= label %><% if (total !== null) { %> <span class="recipe-sheet-total">(<span data-unit="metric"><%= it.recipeMass(total, "metric", key) %></span><span data-unit="us"><%= it.recipeMass(total, "us", key) %></span>)</span><% } %></h4>
            <% if (rows.length === 0) { %><p class="muted">Not recorded.</p><% } else { %><ul class="recipe-sheet-ingredients">
              <% for (const row of rows) { %><li>
                <div class="recipe-sheet-ingredient"><span class="recipe-sheet-amount"><span data-unit="metric"><%= it.recipeAmount(row, "metric", key) %></span><span data-unit="us"><%= it.recipeAmount(row, "us", key) %></span></span><strong><%= row.name %></strong></div>
                <div class="recipe-sheet-detail"><% if (row.supplier) { %><span><%= row.supplier %></span><% } %><% if (row.percent !== null) { %><span><%= it.recipeNumber(row.percent, 1) %>%</span><% } %><% if (row.colorLovibond !== null) { %><span><%= it.recipeNumber(row.colorLovibond, 1) %> °L</span><% } %><% if (row.alphaPercent !== null) { %><span><%= it.recipeNumber(row.alphaPercent, 1) %>% alpha</span><% } %><% if (row.stage) { %><span><%= stageLabels[row.stage] || row.stage %></span><% } %><% if (row.time !== null) { %><span><%= it.recipeNumber(row.time) %><% if (row.timeUnit) { %> <%= row.timeUnit === "day" ? (row.time === 1 ? "day" : "days") : "min" %><% } %></span><% } %><% if (row.temperatureC !== null) { %><span><span data-unit="metric"><%= it.temperature(row.temperatureC, "metric") %></span><span data-unit="us"><%= it.temperature(row.temperatureC, "us") %></span></span><% } %></div>
                <% if (row.note) { %><p class="recipe-sheet-row-note"><%= row.note %></p><% } %>
              </li><% } %>
            </ul><% } %>
          </section>
        <% } } %>
      </div>
      <div class="recipe-sheet-column">
        <section class="recipe-sheet-section" aria-label="Batch and boil">
          <h4>Batch &amp; boil</h4><dl>
            <% if (sheet.summary.method) { %><dt>Method</dt><dd><%= sheet.summary.method %></dd><% } %>
            <dt>Batch size</dt><dd><% if (sheet.summary.batchSizeL !== null) { %><span data-unit="metric"><%= it.volume(sheet.summary.batchSizeL * 1000, "metric") %></span><span data-unit="us"><%= it.volume(sheet.summary.batchSizeL * 1000, "us") %></span><% } else { %>Not recorded<% } %></dd>
            <dt>Boil time</dt><dd><% if (sheet.summary.boilTimeMinutes !== null) { %><%= it.recipeNumber(sheet.summary.boilTimeMinutes) %> min<% } else { %>Not recorded<% } %></dd>
          </dl>
        </section>
        <% for (const [key, label] of [["mash", "Mash profile"], ["fermentation", "Fermentation profile"], ["otherSteps", "Other steps"]]) { const steps = sheet[key]; if (key !== "otherSteps" || steps.length > 0) { %>
          <section class="recipe-sheet-section" aria-label="<%= label %>"><h4><%= label %></h4>
            <% if (steps.length === 0) { %><p class="muted">Not recorded.</p><% } else { %><ol class="recipe-sheet-steps"><% for (const step of steps) { %><li><strong><%= step.name %></strong><div class="recipe-sheet-detail"><% if (step.temperatureC !== null) { %><span><span data-unit="metric"><%= it.temperature(step.temperatureC, "metric") %></span><span data-unit="us"><%= it.temperature(step.temperatureC, "us") %></span></span><% } %><% if (step.time !== null) { %><span><%= it.recipeNumber(step.time) %><% if (step.timeUnit) { %> <%= step.timeUnit === "day" ? (step.time === 1 ? "day" : "days") : "min" %><% } %></span><% } %></div><% if (step.note) { %><p class="recipe-sheet-row-note"><%= step.note %></p><% } %></li><% } %></ol><% } %>
          </section>
        <% } } %>
        <section class="recipe-sheet-section" aria-label="Water profile"><h4>Water profile</h4>
          <% if (sheet.water.ions.length === 0 && sheet.water.mashPh === null && sheet.water.sulfateChlorideRatio === null) { %><p class="muted">Not recorded.</p><% } else { %><dl><% for (const ion of sheet.water.ions) { %><dt><%= ion.label %></dt><dd><%= it.recipeNumber(ion.mgPerL, 1) %> mg/L</dd><% } %><% if (sheet.water.sulfateChlorideRatio !== null) { %><dt>SO₄/Cl ratio</dt><dd><%= it.recipeNumber(sheet.water.sulfateChlorideRatio, 2) %></dd><% } %><% if (sheet.water.mashPh !== null) { %><dt>Target mash pH</dt><dd><%= it.recipeNumber(sheet.water.mashPh, 2) %></dd><% } %></dl><% } %>
        </section>
        <section class="recipe-sheet-section" aria-label="Recorded measurements"><h4>Recorded measurements</h4><dl>
          <% for (const [key, label] of [["og", "Original gravity"], ["fg", "Final gravity"]]) { if (sheet.measurements[key] !== null) { %><dt><%= label %></dt><dd><%= sheet.measurements[key].toFixed(3) %></dd><% } } %>
          <% if (sheet.measurements.fermenterVolumeL !== null) { %><dt>Fermenter volume</dt><dd><span data-unit="metric"><%= it.volume(sheet.measurements.fermenterVolumeL * 1000, "metric") %></span><span data-unit="us"><%= it.volume(sheet.measurements.fermenterVolumeL * 1000, "us") %></span></dd><% } %>
        </dl><% if (Object.values(sheet.measurements).every(value => value === null)) { %><p class="muted">Not recorded or unavailable.</p><% } %></section>
      </div>
    </div>
  <% } else { %>
    <% if (recipe.ingredients.length > 0) { %><h4>Ingredients</h4><ul class="story-recipe-list"><% for (const row of recipe.ingredients) { %><li><%= row.name %><% if (row.amount !== null) { %> — <%= row.amount %><% } %><% if (row.unit) { %> <%= row.unit %><% } %><% if (row.note) { %> (<%= row.note %>)<% } %></li><% } %></ul><% } %>
    <% if (recipe.steps.length > 0) { %><h4>Steps</h4><ol class="story-recipe-steps"><% for (const step of recipe.steps) { %><li><%= step.name || step.text %><% if (step.temperatureC !== null) { %> · <span data-unit="metric"><%= it.temperature(step.temperatureC, "metric") %></span><span data-unit="us"><%= it.temperature(step.temperatureC, "us") %></span><% } %><% if (step.timeMinutes !== null) { %> · <%= step.timeMinutes %> min<% } %><% if (step.note) { %> — <%= step.note %><% } %></li><% } %></ol><% } %>
    <% if (recipe.ingredients.length === 0 && recipe.steps.length === 0) { %><p class="muted">No recipe details are available.</p><% } %>
  <% } %>
</article>
