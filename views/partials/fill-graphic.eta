<%
  const graphic = it.tap.graphic || {
    id: "pint_glass",
    token: "vessel/pint-glass",
    bodyPath: "M 45 40 H 115 L 105 225 H 55 Z",
    clipPath: "M 30 0 H 130 L 114 45 L 104 225 H 56 L 46 45 Z",
    rimPath: "M 45 40 H 115",
    viewBox: "0 40 160 190",
    topY: 45,
    bottomY: 225,
    fillX: 30,
    fillWidth: 100,
    detailPaths: []
  };
  const clipId = `fill-clip-${String(it.tap.id).replace(/[^a-zA-Z0-9_-]/gu, "-").slice(0, 80)}`;
  const bubbleClipId = `${clipId}-bubbles`;
  const percent = typeof it.tap.fillPercent === "number" ? Math.max(0, Math.min(100, it.tap.fillPercent)) : 0;
  const liquidY = graphic.bottomY - ((graphic.bottomY - graphic.topY) * percent) / 100;
  const liquidHeight = graphic.bottomY - liquidY + 4;
  const graphicLabel = it.tap.accessibleLabel || it.tap.title || `Tap ${it.tap.tapNumber}`;
  const color = typeof it.tap.displayColor === "string" && /^#[0-9A-Fa-f]{6}$/u.test(it.tap.displayColor) ? it.tap.displayColor : "#D97706";
  const foamColor = color === "#080100" || color === "#130100" || color === "#200100" ? "#F5EBE6" : "#FFFDF5";
  const foamCenter = graphic.fillX + graphic.fillWidth / 2;
  const bubbleSpecs = [[0.18, 5, 2.3], [0.4, 10, 1.7], [0.62, 7, 2.1], [0.82, 15, 1.5], [0.3, 22, 1.4], [0.7, 27, 1.8], [0.1, 34, 1.2], [0.52, 39, 1.5], [0.9, 44, 1.1], [0.25, 50, 1.6], [0.68, 57, 1.3], [0.45, 64, 1.1], [0.08, 14, 1.5], [0.56, 18, 2], [0.78, 25, 1.2], [0.32, 31, 1.8], [0.92, 38, 1.3], [0.15, 45, 1.1], [0.58, 51, 1.4], [0.83, 58, 1.7], [0.38, 67, 1.2], [0.72, 76, 1.4], [0.24, 86, 1.1], [0.64, 95, 1.3]];
%>
<svg class="tap-graphic" data-graphic-id="<%= graphic.id %>" data-graphic-token="<%= graphic.token %>" data-fill-top-y="<%= graphic.topY %>" data-fill-bottom-y="<%= graphic.bottomY %>" viewBox="<%= graphic.viewBox %>" role="img" aria-label="<%= graphicLabel %> fill level">
  <title><%= graphicLabel %> fill level</title>
  <defs>
    <clipPath id="<%= clipId %>" class="beer-liquid-clip"><path d="<%= graphic.clipPath %>" /></clipPath>
    <clipPath id="<%= bubbleClipId %>" class="beer-bubble-clip"><rect class="beer-bubble-clip-rect" x="<%= graphic.fillX %>" y="<%= liquidY %>" width="<%= graphic.fillWidth %>" height="<%= liquidHeight %>" /></clipPath>
  </defs>
  <path class="glass" d="<%= graphic.bodyPath %>" />
  <% for (const item of graphic.detailPaths) { %>
    <path class="<%= item.className %>" d="<%= item.d %>" fill="<%= item.fill %>" stroke="<%= item.stroke %>" stroke-width="<%= item.strokeWidth %>" opacity="<%= item.opacity %>"<% if (item.contour === true) { %> data-glass-contour="true"<% } %> />
  <% } %>
  <g class="beer-liquid-clip" clip-path="url(#<%= clipId %>)">
    <rect class="liquid beer-liquid-rect" x="<%= graphic.fillX %>" y="<%= liquidY %>" width="<%= graphic.fillWidth %>" height="<%= liquidHeight %>" fill="<%= color %>" data-field="fill-graphic" data-fill-percent="<%= percent %>" />
    <rect class="beer-liquid-shadow" x="<%= foamCenter %>" y="<%= liquidY %>" width="<%= graphic.fillWidth / 2 %>" height="<%= liquidHeight %>" fill="rgba(0, 0, 0, 0.22)" />
    <rect class="beer-pour-stream" x="<%= foamCenter - Math.max(2, graphic.fillWidth * 0.025) %>" y="<%= graphic.topY - 32 %>" width="<%= Math.max(4, graphic.fillWidth * 0.05) %>" height="<%= graphic.bottomY - graphic.topY + 32 %>" fill="<%= color %>" />
    <g class="beer-cloud-foam" data-base-y="<%= liquidY %>" transform="translate(0 <%= liquidY %>)"<% if (percent <= 0) { %> hidden<% } %>>
      <rect x="<%= graphic.fillX %>" y="-8" width="<%= graphic.fillWidth %>" height="16" fill="<%= foamColor %>" opacity="0.9" />
      <circle cx="<%= graphic.fillX + graphic.fillWidth * 0.22 %>" cy="-5" r="<%= Math.max(6, graphic.fillWidth * 0.11) %>" fill="<%= foamColor %>" />
      <circle cx="<%= graphic.fillX + graphic.fillWidth * 0.43 %>" cy="-8" r="<%= Math.max(7, graphic.fillWidth * 0.14) %>" fill="<%= foamColor %>" />
      <circle cx="<%= graphic.fillX + graphic.fillWidth * 0.65 %>" cy="-7" r="<%= Math.max(7, graphic.fillWidth * 0.13) %>" fill="<%= foamColor %>" />
      <circle cx="<%= graphic.fillX + graphic.fillWidth * 0.84 %>" cy="-5" r="<%= Math.max(6, graphic.fillWidth * 0.1) %>" fill="<%= foamColor %>" />
      <circle cx="<%= foamCenter %>" cy="-9" r="<%= Math.max(5, graphic.fillWidth * 0.09) %>" fill="#FFFFFF" opacity="0.5" />
    </g>
    <g class="beer-bubbles" clip-path="url(#<%= bubbleClipId %>)"<% if (percent <= 0) { %> hidden<% } %>>
      <% for (let index = 0; index < bubbleSpecs.length; index += 1) { const bubble = bubbleSpecs[index]; %><circle class="beer-bubble" cx="<%= graphic.fillX + graphic.fillWidth * bubble[0] %>" cy="<%= graphic.bottomY - bubble[1] %>" r="<%= bubble[2] %>" fill="#FFFFFF" opacity="0.6" /><% } %>
    </g>
  </g>
  <path class="rim" d="<%= graphic.rimPath %>" />
</svg>
