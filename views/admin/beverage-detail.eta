<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content">
  <nav class="admin-back-link" aria-label="Breadcrumb"><a href="/admin/beverages">← Beverages</a></nav>
  <header class="page-header beverage-detail-header">
    <div class="beverage-detail-header__title">
      <svg class="beverage-color-cue" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><circle cx="5" cy="5" r="5"<% if (it.beverage.displayColor) { %> fill="<%= it.beverage.displayColor %>"<% } else { %> class="beverage-color-cue__fallback"<% } %> /></svg>
      <div><p class="eyebrow"><%= it.beverage.ownershipType === "brewfather" ? "Brewfather linked" : "Custom beverage" %></p><h1><%= it.beverage.name %></h1></div>
    </div>
    <p class="muted" data-beverage-updated-at="<%= it.beverage.updatedAt %>">Last updated <time datetime="<%= it.beverage.updatedAt %>"><%= it.beverage.updatedAt %></time></p>
  </header>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <dl class="summary-grid beverage-summary">
    <div><dt>Style</dt><dd><%= it.beverage.style || "—" %></dd></div>
    <div><dt>ABV</dt><dd><%= it.beverage.abv === null ? "—" : `${it.beverage.abv}%` %></dd></div>
    <div><dt>Current use</dt><dd><%= it.beverage.usage.current === 0 ? "Not in use" : it.beverage.usage.current %></dd></div>
    <div><dt>Source</dt><dd><%= it.beverage.ownershipType === "brewfather" ? "Brewfather" : "Custom" %></dd></div>
    <% if (it.beverage.syncState) { %><div><dt>Sync state</dt><dd><%= it.beverage.syncState %></dd></div><% } %>
  </dl>

  <% if (it.beverage.ownershipType === "custom") { %>
    <section class="admin-card" aria-labelledby="custom-presentation-heading">
      <div class="section-heading"><div><h2 id="custom-presentation-heading">Presentation</h2><p class="muted">Values used wherever this beverage appears.</p></div></div>
      <dl class="key-value-list"><div><dt>Name</dt><dd><%= it.beverage.name %></dd></div><div><dt>Type and style</dt><dd><%= it.beverage.beverageType %><% if (it.beverage.style) { %> · <%= it.beverage.style %><% } %></dd></div><div><dt>ABV</dt><dd><%= it.beverage.abv === null ? "—" : `${it.beverage.abv}%` %></dd></div><div><dt>Fill glass</dt><dd><%= it.beverage.fillGlass || "Default" %></dd></div><div><dt>Description</dt><dd><%= it.beverage.description || "—" %></dd></div></dl>
      <details class="admin-disclosure admin-disclosure--editable">
        <summary><span><strong>Edit presentation</strong><small>Identity, metrics, color, glass, and public description.</small></span></summary>
      <form class="admin-form" action="/admin/beverages/<%= it.beverage.id %>/update" method="post" data-autosave="blur" data-autosave-resource="beverage:<%= it.beverage.id %>" data-autosave-revision="updatedAt" data-autosave-fields="name,beverageType,style,abv,ibu,og,fg,srm,displayColor,description,fillGlass">
        <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
        <input type="hidden" name="updatedAt" value="<%= it.beverage.updatedAt %>" />
        <div class="config-grid">
          <label>Name <input name="name" value="<%= it.beverage.name %>" maxlength="160" required /></label>
          <label>Type <select name="beverageType"><% for (const type of it.beverageTypes) { %><option value="<%= type %>"<% if (it.beverage.beverageType === type) { %> selected<% } %>><%= type[0].toUpperCase() + type.slice(1) %></option><% } %></select></label>
          <label>Style <input name="style" value="<%= it.beverage.style || "" %>" maxlength="120" /></label>
          <label>ABV (%) <input name="abv" type="number" min="0" max="100" step="0.1" value="<%= it.beverage.abv ?? "" %>" /></label>
          <label>IBU <input name="ibu" type="number" min="0" max="2000" step="0.1" value="<%= it.beverage.ibu ?? "" %>" /></label>
          <label>Original gravity <input name="og" type="number" min="0.5" max="2" step="0.001" value="<%= it.beverage.og ?? "" %>" /></label>
          <label>Final gravity <input name="fg" type="number" min="0.5" max="2" step="0.001" value="<%= it.beverage.fg ?? "" %>" /></label>
          <label>SRM <input name="srm" type="number" min="0" max="100" step="0.1" value="<%= it.beverage.srm ?? "" %>" /></label>
          <label>Manual density override <input name="manualDensityOverride" type="number" min="0.5" max="2" step="0.001" value="<%= it.beverage.manualDensityOverride ?? "" %>" /></label>
          <label>Display color <input name="displayColor" value="<%= it.beverage.displayColor || "" %>" pattern="#[0-9A-Fa-f]{6}" /></label>
        </div>
        <%~ include("/partials/fill-glass-picker", { label: "Fill Glass", name: "fillGlass", id: `custom-fill-glass-${it.beverage.id}`, selected: it.beverage.fillGlass || "", options: it.fillGlassOptions || [] }) %>
        <label>Description <textarea name="description" maxlength="4000" rows="4"><%= it.beverage.description || "" %></textarea></label>
        <div class="form-actions"><button class="primary" type="submit">Save presentation</button><output class="autosave-status" data-autosave-status aria-live="polite"></output></div>
      </form>
      </details>
    </section>
  <% } else if (it.beverage.source && it.beverage.overrides) { %>
    <section class="admin-card" aria-labelledby="source-controls-heading">
      <div class="section-heading"><div><h2 id="source-controls-heading">Brewfather presentation</h2><p class="muted">Source values remain read-only; local overrides are available when the inherited presentation needs adjustment.</p></div></div>
      <details class="admin-disclosure admin-disclosure--editable">
        <summary><span><strong>Edit source overrides</strong><small>Choose Override for a local value or Reset to inherited for the latest source value.</small></span></summary>
      <form class="admin-form" action="/admin/beverages/<%= it.beverage.id %>/presentation" method="post" data-autosave="blur" data-autosave-resource="beverage:<%= it.beverage.id %>" data-autosave-revision="updatedAt" data-autosave-fields="nameMode,name,beverageTypeMode,beverageType,styleMode,style,abvMode,abv,ibuMode,ibu,ogMode,og,fgMode,fg,srmMode,srm,displayColorMode,displayColor,descriptionMode,description,fillGlassMode,fillGlass">
        <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
        <input type="hidden" name="updatedAt" value="<%= it.beverage.updatedAt %>" />
        <div class="source-control-grid">
          <fieldset><legend>Name</legend><p><strong>Source:</strong> <%= it.beverage.source.name %></p><p><strong>Effective:</strong> <%= it.beverage.name %></p><label>Mode <select name="nameMode"><option value="inherit"<% if (!it.beverage.overrides.overrideNamePresent) { %> selected<% } %>>Reset to inherited</option><option value="value"<% if (it.beverage.overrides.overrideNamePresent) { %> selected<% } %>>Override</option></select></label><label>Override value <input name="name" value="<%= it.beverage.overrides.name || it.beverage.name %>" maxlength="160" /></label></fieldset>
          <fieldset><legend>Type</legend><p><strong>Source:</strong> <%= it.beverage.source.beverageType %></p><p><strong>Effective:</strong> <%= it.beverage.beverageType %></p><label>Mode <select name="beverageTypeMode"><option value="inherit"<% if (!it.beverage.overrides.overrideBeverageTypePresent) { %> selected<% } %>>Reset to inherited</option><option value="value"<% if (it.beverage.overrides.overrideBeverageTypePresent) { %> selected<% } %>>Override</option></select></label><label>Override value <select name="beverageType"><% for (const type of it.beverageTypes) { %><option value="<%= type %>"<% if ((it.beverage.overrides.beverageType || it.beverage.beverageType) === type) { %> selected<% } %>><%= type[0].toUpperCase() + type.slice(1) %></option><% } %></select></label></fieldset>
          <fieldset><legend>Style</legend><p><strong>Source:</strong> <%= it.beverage.source.style || "—" %></p><p><strong>Effective:</strong> <%= it.beverage.style || "—" %></p><label>Mode <select name="styleMode"><option value="inherit"<% if (!it.beverage.overrides.overrideStylePresent) { %> selected<% } %>>Reset to inherited</option><option value="clear"<% if (it.beverage.overrides.overrideStylePresent && it.beverage.overrides.style === null) { %> selected<% } %>>Clear</option><option value="value"<% if (it.beverage.overrides.overrideStylePresent && it.beverage.overrides.style !== null) { %> selected<% } %>>Override</option></select></label><label>Override value <input name="style" value="<%= it.beverage.overrides.style || it.beverage.style || "" %>" maxlength="120" /></label></fieldset>
          <fieldset><legend>ABV</legend><p><strong>Source:</strong> <%= it.beverage.source.abv === null ? "—" : `${it.beverage.source.abv}%` %></p><p><strong>Effective:</strong> <%= it.beverage.abv === null ? "—" : `${it.beverage.abv}%` %></p><label>Mode <select name="abvMode"><option value="inherit"<% if (!it.beverage.overrides.overrideAbvPresent) { %> selected<% } %>>Reset to inherited</option><option value="clear"<% if (it.beverage.overrides.overrideAbvPresent && it.beverage.overrides.abv === null) { %> selected<% } %>>Clear</option><option value="value"<% if (it.beverage.overrides.overrideAbvPresent && it.beverage.overrides.abv !== null) { %> selected<% } %>>Override</option></select></label><label>Override value <input name="abv" type="number" min="0" max="100" step="0.1" value="<%= it.beverage.overrides.abv ?? it.beverage.abv ?? "" %>" /></label></fieldset>
          <fieldset><legend>IBU</legend><p><strong>Source:</strong> <%= it.beverage.source.ibu === null ? "—" : it.beverage.source.ibu %></p><p><strong>Effective:</strong> <%= it.beverage.ibu === null ? "—" : it.beverage.ibu %></p><label>Mode <select name="ibuMode"><option value="inherit"<% if (!it.beverage.overrides.overrideIbuPresent) { %> selected<% } %>>Reset to inherited</option><option value="clear"<% if (it.beverage.overrides.overrideIbuPresent && it.beverage.overrides.ibu === null) { %> selected<% } %>>Clear</option><option value="value"<% if (it.beverage.overrides.overrideIbuPresent && it.beverage.overrides.ibu !== null) { %> selected<% } %>>Override</option></select></label><label>Override value <input name="ibu" type="number" min="0" max="2000" step="0.1" value="<%= it.beverage.overrides.ibu ?? it.beverage.ibu ?? "" %>" /></label></fieldset>
          <fieldset><legend>Original gravity</legend><p><strong>Source:</strong> <%= it.beverage.source.og ?? "—" %></p><p><strong>Effective:</strong> <%= it.beverage.og ?? "—" %></p><label>Mode <select name="ogMode"><option value="inherit"<% if (!it.beverage.overrides.overrideOgPresent) { %> selected<% } %>>Reset to inherited</option><option value="clear"<% if (it.beverage.overrides.overrideOgPresent && it.beverage.overrides.og === null) { %> selected<% } %>>Clear</option><option value="value"<% if (it.beverage.overrides.overrideOgPresent && it.beverage.overrides.og !== null) { %> selected<% } %>>Override</option></select></label><label>Override value <input name="og" type="number" min="0.5" max="2" step="0.001" value="<%= it.beverage.overrides.og ?? it.beverage.og ?? "" %>" /></label></fieldset>
          <fieldset><legend>Final gravity</legend><p><strong>Source:</strong> <%= it.beverage.source.fg ?? "—" %></p><p><strong>Effective:</strong> <%= it.beverage.fg ?? "—" %></p><label>Mode <select name="fgMode"><option value="inherit"<% if (!it.beverage.overrides.overrideFgPresent) { %> selected<% } %>>Reset to inherited</option><option value="clear"<% if (it.beverage.overrides.overrideFgPresent && it.beverage.overrides.fg === null) { %> selected<% } %>>Clear</option><option value="value"<% if (it.beverage.overrides.overrideFgPresent && it.beverage.overrides.fg !== null) { %> selected<% } %>>Override</option></select></label><label>Override value <input name="fg" type="number" min="0.5" max="2" step="0.001" value="<%= it.beverage.overrides.fg ?? it.beverage.fg ?? "" %>" /></label></fieldset>
          <fieldset><legend>SRM</legend><p><strong>Source:</strong> <%= it.beverage.source.srm ?? "—" %></p><p><strong>Effective:</strong> <%= it.beverage.srm ?? "—" %></p><label>Mode <select name="srmMode"><option value="inherit"<% if (!it.beverage.overrides.overrideSrmPresent) { %> selected<% } %>>Reset to inherited</option><option value="clear"<% if (it.beverage.overrides.overrideSrmPresent && it.beverage.overrides.srm === null) { %> selected<% } %>>Clear</option><option value="value"<% if (it.beverage.overrides.overrideSrmPresent && it.beverage.overrides.srm !== null) { %> selected<% } %>>Override</option></select></label><label>Override value <input name="srm" type="number" min="0" max="100" step="0.1" value="<%= it.beverage.overrides.srm ?? it.beverage.srm ?? "" %>" /></label></fieldset>
          <fieldset><legend>Display color</legend><p><strong>Source:</strong> <%= it.beverage.source.displayColor || "—" %></p><p><strong>Effective:</strong> <%= it.beverage.displayColor || "—" %></p><label>Mode <select name="displayColorMode"><option value="inherit"<% if (!it.beverage.overrides.overrideDisplayColorPresent) { %> selected<% } %>>Reset to inherited</option><option value="clear"<% if (it.beverage.overrides.overrideDisplayColorPresent && it.beverage.overrides.displayColor === null) { %> selected<% } %>>Clear</option><option value="value"<% if (it.beverage.overrides.overrideDisplayColorPresent && it.beverage.overrides.displayColor !== null) { %> selected<% } %>>Override</option></select></label><label>Override value <input name="displayColor" value="<%= it.beverage.overrides.displayColor || it.beverage.displayColor || "" %>" pattern="#[0-9A-Fa-f]{6}" /></label></fieldset>
          <fieldset><legend>Description</legend><p><strong>Source:</strong> <%= it.beverage.source.description || "—" %></p><p><strong>Effective:</strong> <%= it.beverage.description || "—" %></p><label>Mode <select name="descriptionMode"><option value="inherit"<% if (!it.beverage.overrides.overrideDescriptionPresent) { %> selected<% } %>>Reset to inherited</option><option value="clear"<% if (it.beverage.overrides.overrideDescriptionPresent && it.beverage.overrides.description === null) { %> selected<% } %>>Clear</option><option value="value"<% if (it.beverage.overrides.overrideDescriptionPresent && it.beverage.overrides.description !== null) { %> selected<% } %>>Override</option></select></label><label>Override value <textarea name="description" maxlength="4000"><%= it.beverage.overrides.description || it.beverage.description || "" %></textarea></label></fieldset>
          <fieldset><legend>Fill Glass</legend><p><strong>Source:</strong> Style suggestion</p><p><strong>Effective:</strong> <%= it.beverage.fillGlass || "Style suggestion" %></p><label>Mode <select name="fillGlassMode"><option value="inherit"<% if (!it.beverage.overrides.overrideFillGlassPresent) { %> selected<% } %>>Reset to inherited</option><option value="clear"<% if (it.beverage.overrides.overrideFillGlassPresent && it.beverage.overrides.fillGlass === null) { %> selected<% } %>>Clear</option><option value="value"<% if (it.beverage.overrides.overrideFillGlassPresent && it.beverage.overrides.fillGlass !== null) { %> selected<% } %>>Override</option></select></label><%~ include("/partials/fill-glass-picker", { label: "Override vessel", name: "fillGlass", id: `source-fill-glass-${it.beverage.id}`, selected: it.beverage.overrides.overrideFillGlassPresent ? (it.beverage.overrides.fillGlass || "") : "", options: it.fillGlassOptions || [] }) %></fieldset>
          <fieldset><legend>Manual density</legend><p><strong>Source:</strong> Not supplied</p><p><strong>Effective:</strong> <%= it.beverage.manualDensityOverride ?? "Fallback/FG derived" %></p><label>Mode <select name="manualDensityOverrideMode"><option value="inherit"<% if (!it.beverage.overrides.overrideManualDensityOverridePresent) { %> selected<% } %>>Reset to inherited</option><option value="clear"<% if (it.beverage.overrides.overrideManualDensityOverridePresent && it.beverage.overrides.manualDensityOverride === null) { %> selected<% } %>>Clear</option><option value="value"<% if (it.beverage.overrides.overrideManualDensityOverridePresent && it.beverage.overrides.manualDensityOverride !== null) { %> selected<% } %>>Override</option></select></label><label>Override value <input name="manualDensityOverride" type="number" min="0.5" max="2" step="0.001" value="<%= it.beverage.overrides.manualDensityOverride ?? it.beverage.manualDensityOverride ?? "" %>" /></label></fieldset>
        </div>
        <div class="form-actions"><button class="primary" type="submit">Save Brewfather presentation</button><output class="autosave-status" data-autosave-status aria-live="polite"></output></div>
      </form>
      <form class="admin-form" action="/admin/beverages/<%= it.beverage.id %>/unlink" method="post">
        <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
        <input type="hidden" name="updatedAt" value="<%= it.beverage.updatedAt %>" />
        <button class="secondary" type="submit">Unlink and retain as custom</button>
      </form>
      </details>
    </section>
  <% } %>

  <section class="admin-card" aria-labelledby="sensory-heading">
    <div class="section-heading"><div><h2 id="sensory-heading">Sensory guidance</h2><p class="muted">Canonical manual overrides use a 0–10 scale; derived guidance is shown below when available.</p></div></div>
    <% if (it.beverage.guidance) { %><dl class="sensory-guidance"><% for (const axis of ["bitterness", "sweetness", "body", "roast", "tartness", "alcohol"]) { const result = it.beverage.guidance.sensory[axis]; %><dt><%= axis[0].toUpperCase() + axis.slice(1) %></dt><dd><%= result.value === null ? "Unavailable" : `${result.value} / 5` %> · <%= result.source.replace(/_/gu, " ") %><% if (result.confidence) { %> · <%= result.confidence %> confidence<% } %><% if (result.evidence) { %> · <%= result.evidence %><% } %></dd><% } %></dl><% } else { %><p class="muted">Guidance is unavailable until a compatible source or manual override is present.</p><% } %>
    <details class="admin-disclosure admin-disclosure--editable">
      <summary><span><strong>Edit sensory overrides</strong><small>Advanced manual values from 0 to 10.</small></span></summary>
      <form class="admin-form" action="/admin/beverages/<%= it.beverage.id %>/sensory" method="post">
        <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
        <input type="hidden" name="updatedAt" value="<%= it.beverage.updatedAt %>" />
        <div class="config-grid"><% for (const axis of ["bitterness", "sweetness", "body", "roast", "tartness", "alcohol"]) { %><label><%= axis[0].toUpperCase() + axis.slice(1) %><input name="<%= axis %>" type="number" min="0" max="10" step="0.1" value="<%= it.beverage.sensoryOverrides?.[axis] ?? "" %>" /></label><% } %></div>
        <button class="secondary" type="submit">Save sensory overrides</button>
      </form>
    </details>
  </section>

  <% if (it.beverage.ownershipType === "custom") { %>
    <section class="admin-card" aria-labelledby="recipe-heading"><div class="section-heading"><div><h2 id="recipe-heading">Custom recipe</h2><p class="muted">Keep process notes and ingredients close to the beverage record.</p></div></div><details class="admin-disclosure"><summary><span><strong>Edit recipe data</strong><small>Advanced structured recipe content.</small></span></summary><form class="admin-form" action="/admin/beverages/<%= it.beverage.id %>/recipe" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.beverage.updatedAt %>" /><label>Recipe JSON <textarea name="recipeJson" rows="16" spellcheck="false"><%= it.beverage.customRecipeJson %></textarea></label><p class="muted">Leave blank (or enter <code>null</code>) to remove the custom recipe.</p><button class="secondary" type="submit">Save custom recipe</button></form></details></section>
  <% } else if (it.beverage.guidance && it.beverage.guidance.sourceRecipes.length > 0) { %>
    <section class="admin-card" aria-labelledby="source-recipe-heading"><div class="section-heading"><div><h2 id="source-recipe-heading">Source recipe guidance</h2><p class="muted">Read-only, bounded recipe presentation from the linked Brewfather snapshot.</p></div></div><details class="admin-disclosure"><summary><span><strong>Show source recipe</strong><small>Ingredients, notes, and provenance.</small></span></summary><% for (const recipe of it.beverage.guidance.sourceRecipes) { %><article class="source-recipe"><h3><%= recipe.provenance?.label || "Source recipe" %></h3><p class="muted"><%= recipe.status || "available" %></p><% if (recipe.notes) { %><p><%= recipe.notes %></p><% } %><ul><% for (const ingredient of recipe.ingredients) { %><li><%= ingredient.name %><% if (ingredient.amount !== null) { %> — <%= ingredient.amount %><% } %><% if (ingredient.unit) { %> <%= ingredient.unit %><% } %></li><% } %></ul></article><% } %></details></section>
  <% } %>

  <section class="admin-card" aria-labelledby="fill-heading"><div class="section-heading"><div><h2 id="fill-heading">Current usage</h2><p class="muted"><%= it.beverage.usage.total %> fill record<%= it.beverage.usage.total === 1 ? "" : "s" %> linked to this beverage.</p></div></div><% if ((it.beverage.currentFills || []).length > 0) { %><div class="table-scroll"><table class="admin-table"><caption class="sr-only">Current Filled Kegs</caption><thead><tr><th scope="col">Filled Keg</th><th scope="col">State</th><th scope="col">Tap</th><th scope="col">Fill date</th></tr></thead><tbody><% for (const fill of it.beverage.currentFills) { %><tr><th scope="row"><a href="/admin/keg-room/fills/<%= fill.id %>">Keg <%= fill.kegNumber %><% if (fill.kegLabel) { %> — <%= fill.kegLabel %><% } %></a><br /><a class="muted" href="/admin/keg-room/kegs/<%= fill.kegId %>">Physical Keg detail</a></th><td><span class="status-badge status-badge--<%= fill.state %>"><%= fill.state.replaceAll("_", " ") %></span></td><td><% if (fill.tapId) { %><a href="/admin/taps/<%= fill.tapId %>">Tap <%= fill.tapNumber %></a><% } else { %>—<% } %></td><td><%= fill.fillDate %></td></tr><% } %></tbody></table></div><% } else { %><p class="muted">No current Filled Kegs use this beverage.</p><% } %><% if ((it.availableKegs || []).length === 0) { %><p class="muted">No empty active kegs are available for a new fill.</p><% } else { %><form class="admin-form" action="/admin/beverages/<%= it.beverage.id %>/create-fill" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.beverage.updatedAt %>" /><div class="config-grid"><label>Physical keg <select name="kegId" required><option value="">Choose keg</option><% for (const keg of it.availableKegs) { %><option value="<%= keg.id %>">Keg <%= keg.kegNumber %><% if (keg.label) { %> — <%= keg.label %><% } %></option><% } %></select></label><label>Fill date <input name="fillDate" type="date" /></label></div><button class="secondary" type="submit">Create fill</button></form><% } %></section>

  <section class="admin-card danger-zone" aria-labelledby="delete-heading"><div class="section-heading"><div><h2 id="delete-heading">Permanent deletion</h2><p class="muted">This removes the beverage and its dependent records. The confirmation must exactly match the current effective name.</p></div></div><ul class="impact-list"><% for (const impact of it.beverage.deletionImpacts) { %><li><%= impact.code %>: <%= impact.count %></li><% } %></ul><div class="confirmation-copy" data-copy-group><label for="beverage-confirmation-value-<%= it.beverage.id %>">Exact confirmation value</label><div class="confirmation-copy__row"><input id="beverage-confirmation-value-<%= it.beverage.id %>" readonly value="<%= it.beverage.name %>" /><button class="secondary" type="button" data-copy-target="beverage-confirmation-value-<%= it.beverage.id %>">Copy</button></div><output data-copy-status aria-live="polite"></output></div><form class="admin-form" action="/admin/beverages/<%= it.beverage.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.beverage.updatedAt %>" /><label>Type the exact value above to confirm <input name="confirmationName" autocomplete="off" required /></label><label>Reason <input name="reason" maxlength="255" /></label><button class="danger" type="submit">Permanently delete beverage</button></form></section>
</main>
