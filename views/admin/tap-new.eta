<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content">
  <nav class="admin-back-link" aria-label="Breadcrumb"><a href="/admin/taps">← Taps</a></nav>
  <header class="page-header">
    <p class="eyebrow">Manage · Taps</p>
    <h1>New Tap</h1>
    <p class="muted">Create a serving position first; assignment and operational controls are available after it exists.</p>
  </header>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section class="admin-card" aria-labelledby="new-tap-heading">
    <h2 id="new-tap-heading">Tap identity and serving setup</h2>
    <form class="admin-form" action="/admin/taps/create" method="post">
      <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
      <div class="config-grid">
        <label>Tap number <input name="tapNumber" type="number" min="1" max="1000000" required /></label>
        <label>Name <input name="name" maxlength="120" placeholder="Optional" /></label>
        <label>Public display
          <select name="enabled">
            <option value="true" selected>Enabled</option>
            <option value="false">Disabled</option>
          </select>
        </label>
        <label>Gas type <input name="gasType" maxlength="64" placeholder="Optional" /></label>
        <label>Serving pressure (kPa) <input name="servingPressureKpa" type="number" min="0" step="any" /></label>
        <label>Line length (mm) <input name="lineLengthMm" type="number" min="0" step="1" /></label>
        <label>Line diameter (mm) <input name="lineDiameterMm" type="number" min="0" step="any" /></label>
      </div>
      <label>Notes <textarea name="notes" maxlength="2048" rows="4"></textarea></label>
      <div class="form-actions"><button class="primary" type="submit">Create Tap</button><a class="button secondary" href="/admin/taps">Cancel</a></div>
    </form>
  </section>
</main>
