<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content">
  <h1>Beverages</h1>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section aria-labelledby="beverage-list-heading"><h2 id="beverage-list-heading">Beverage library</h2>
    <% if (it.beverages.length === 0) { %><p>No Beverages are configured.</p><% } else { %>
      <div class="resource-list"><% for (const item of it.beverages) { const guidance = item.guidance; %>
        <article class="resource-card"><h3><%= item.name %></h3><p><strong><%= item.ownershipType === "custom" ? "Custom" : "Brewfather linked" %></strong><% if (item.style) { %> · <%= item.style %><% } %><% if (typeof item.abv === "number") { %> · <%= item.abv %>% ABV<% } %></p>
        <% if (item.description) { %><p><%= item.description %></p><% } %>
        <section aria-labelledby="sensory-<%= item.id %>"><h4 id="sensory-<%= item.id %>">Sensory guidance</h4><% if (guidance) { %><dl class="sensory-guidance"><% for (const axis of ["bitterness", "sweetness", "body", "roast", "tartness", "alcohol"]) { const result = guidance.sensory[axis]; %><dt><%= axis[0].toUpperCase() + axis.slice(1) %></dt><dd><%= result.value === null ? "Unavailable" : result.value + " / 5" %> · <%= result.source.replace(/_/gu, " ") %><% if (result.confidence) { %> · <%= result.confidence %> confidence<% } %></dd><% } %></dl><% } else { %><p>Guidance is unavailable.</p><% } %><form action="/admin/beverages/<%= item.id %>/sensory" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><p>Enter canonical manual overrides from 0 to 10. Public guidance maps them deterministically to 0 to 5. Leave blank to clear an axis.</p><div class="config-grid"><% for (const axis of ["bitterness", "sweetness", "body", "roast", "tartness", "alcohol"]) { %><label><%= axis[0].toUpperCase() + axis.slice(1) %><input name="<%= axis %>" type="number" min="0" max="10" step="0.1" value="<%= item.sensoryOverrides?.[axis] ?? "" %>" /></label><% } %></div><button type="submit">Save sensory overrides</button></form></section>
        <% if (item.ownershipType === "custom") { %>
          <details><summary>Edit custom beverage</summary><form action="/admin/beverages/<%= item.id %>/update" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Name <input name="name" value="<%= item.name %>" required /></label><label>Type <input name="beverageType" value="<%= item.beverageType %>" required /></label><label>Style <input name="style" value="<%= item.style || "" %>" /></label><label>ABV <input name="abv" type="number" min="0" max="100" step="0.1" value="<%= typeof item.abv === "number" ? item.abv : "" %>" /></label><label>Display color <input name="displayColor" value="<%= item.displayColor || "" %>" pattern="#[0-9A-Fa-f]{6}" /></label><%~ include("/partials/fill-glass-picker", { label: "Fill Glass", name: "fillGlass", id: `custom-fill-glass-${item.id}`, selected: item.fillGlass || "", options: it.fillGlassOptions || [] }) %><label>Description <textarea name="description"><%= item.description || "" %></textarea></label><button type="submit">Update Beverage</button></form></details>
          <details><summary>Custom recipe</summary><form action="/admin/beverages/<%= item.id %>/recipe" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><p>Enter the bounded recipe JSON object below. This preserves pipes, line breaks, ampersands, HTML-like text, and Unicode. Leave it blank (or enter <code>null</code>) to delete the recipe.</p><label>Recipe JSON <textarea name="recipeJson" rows="16" spellcheck="false"><%= item.customRecipeJson || "" %></textarea></label><button type="submit">Save custom recipe</button></form></details>
        <% } %>
        <% if (item.ownershipType === "brewfather") { %>
          <details><summary>Source and display overrides</summary><p>Each field shows the sanitized source value and the effective value currently displayed. Inherit follows the source; Clear removes nullable values; Value uses the override input.</p><form action="/admin/beverages/<%= item.id %>/presentation" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
            <fieldset><legend>Name</legend><p>Source: <%= item.brewfatherPresentation.source.name %></p><p>Effective: <%= item.name %></p><label>Mode <select name="nameMode"><option value="inherit"<% if (!item.brewfatherPresentation.overrides.overrideNamePresent) { %> selected<% } %>>Inherit (source)</option><option value="value"<% if (item.brewfatherPresentation.overrides.overrideNamePresent) { %> selected<% } %>>Value (override)</option></select></label><label>Override value <input name="name" value="<%= item.name %>" /></label></fieldset>
            <fieldset><legend>Type</legend><p>Source: <%= item.brewfatherPresentation.source.beverageType %></p><p>Effective: <%= item.beverageType %></p><label>Mode <select name="beverageTypeMode"><option value="inherit"<% if (!item.brewfatherPresentation.overrides.overrideBeverageTypePresent) { %> selected<% } %>>Inherit (source)</option><option value="value"<% if (item.brewfatherPresentation.overrides.overrideBeverageTypePresent) { %> selected<% } %>>Value (override)</option></select></label><label>Override value <input name="beverageType" value="<%= item.beverageType %>" /></label></fieldset>
            <fieldset><legend>Style</legend><p>Source: <%= item.brewfatherPresentation.source.style || "—" %></p><p>Effective: <%= item.style || "—" %></p><label>Mode <select name="styleMode"><option value="inherit"<% if (!item.brewfatherPresentation.overrides.overrideStylePresent) { %> selected<% } %>>Inherit (source)</option><option value="clear"<% if (item.brewfatherPresentation.overrides.overrideStylePresent && item.brewfatherPresentation.overrides.style === null) { %> selected<% } %>>Clear</option><option value="value"<% if (item.brewfatherPresentation.overrides.overrideStylePresent && item.brewfatherPresentation.overrides.style !== null) { %> selected<% } %>>Value (override)</option></select></label><label>Override value <input name="style" value="<%= item.style || "" %>" /></label></fieldset>
            <fieldset><legend>ABV</legend><p>Source: <%= item.brewfatherPresentation.source.abv === null ? "—" : item.brewfatherPresentation.source.abv + "%" %></p><p>Effective: <%= item.abv === null ? "—" : item.abv + "%" %></p><label>Mode <select name="abvMode"><option value="inherit"<% if (!item.brewfatherPresentation.overrides.overrideAbvPresent) { %> selected<% } %>>Inherit (source)</option><option value="clear"<% if (item.brewfatherPresentation.overrides.overrideAbvPresent && item.brewfatherPresentation.overrides.abv === null) { %> selected<% } %>>Clear</option><option value="value"<% if (item.brewfatherPresentation.overrides.overrideAbvPresent && item.brewfatherPresentation.overrides.abv !== null) { %> selected<% } %>>Value (override)</option></select></label><label>Override value <input name="abv" type="number" min="0" max="100" step="0.1" value="<%= typeof item.abv === "number" ? item.abv : "" %>" /></label></fieldset>
            <fieldset><legend>Display color</legend><p>Source: <%= item.brewfatherPresentation.source.displayColor || "—" %></p><p>Effective: <%= item.displayColor || "—" %></p><label>Mode <select name="displayColorMode"><option value="inherit"<% if (!item.brewfatherPresentation.overrides.overrideDisplayColorPresent) { %> selected<% } %>>Inherit (source)</option><option value="clear"<% if (item.brewfatherPresentation.overrides.overrideDisplayColorPresent && item.brewfatherPresentation.overrides.displayColor === null) { %> selected<% } %>>Clear</option><option value="value"<% if (item.brewfatherPresentation.overrides.overrideDisplayColorPresent && item.brewfatherPresentation.overrides.displayColor !== null) { %> selected<% } %>>Value (override)</option></select></label><label>Override value <input name="displayColor" value="<%= item.displayColor || "" %>" pattern="#[0-9A-Fa-f]{6}" /></label></fieldset>
            <fieldset><legend>Description</legend><p>Source: <%= item.brewfatherPresentation.source.description || "—" %></p><p>Effective: <%= item.description || "—" %></p><label>Mode <select name="descriptionMode"><option value="inherit"<% if (!item.brewfatherPresentation.overrides.overrideDescriptionPresent) { %> selected<% } %>>Inherit (source)</option><option value="clear"<% if (item.brewfatherPresentation.overrides.overrideDescriptionPresent && item.brewfatherPresentation.overrides.description === null) { %> selected<% } %>>Clear</option><option value="value"<% if (item.brewfatherPresentation.overrides.overrideDescriptionPresent && item.brewfatherPresentation.overrides.description !== null) { %> selected<% } %>>Value (override)</option></select></label><label>Override value <textarea name="description"><%= item.description || "" %></textarea></label></fieldset>
            <fieldset><legend>Fill Glass</legend><p>Effective: <%= item.fillGlass || "Style suggestion" %></p><label>Mode <select name="fillGlassMode"><option value="inherit"<% if (!item.brewfatherPresentation.overrides.overrideFillGlassPresent) { %> selected<% } %>>Inherit (style suggestion)</option><option value="clear"<% if (item.brewfatherPresentation.overrides.overrideFillGlassPresent && item.brewfatherPresentation.overrides.fillGlass === null) { %> selected<% } %>>Clear</option><option value="value"<% if (item.brewfatherPresentation.overrides.overrideFillGlassPresent && item.brewfatherPresentation.overrides.fillGlass !== null) { %> selected<% } %>>Value (override)</option></select></label><%~ include("/partials/fill-glass-picker", { label: "Catalog vessel", name: "fillGlass", id: `brewfather-fill-glass-${item.id}`, selected: item.brewfatherPresentation.overrides.overrideFillGlassPresent ? (item.brewfatherPresentation.overrides.fillGlass || "") : "", options: it.fillGlassOptions || [] }) %></fieldset><button type="submit">Save display overrides</button></form></details>
          <p>Source recipe data is read-only and displayed below with safe provenance labels.</p><% if (guidance && guidance.sourceRecipes.length > 0) { %><details><summary>Linked source recipes</summary><% for (const recipe of guidance.sourceRecipes) { %><article><h4><%= recipe.provenance?.label || "Source recipe" %></h4><p>Status: <%= recipe.status %></p><% if (recipe.notes) { %><p><%= recipe.notes %></p><% } %><ul><% for (const ingredient of recipe.ingredients) { %><li><%= ingredient.name %><% if (ingredient.amount !== null) { %> — <%= ingredient.amount %><% } %><% if (ingredient.unit) { %> <%= ingredient.unit %><% } %></li><% } %></ul></article><% } %></details><% } %><form action="/admin/beverages/<%= item.id %>/unlink" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button type="submit">Unlink and keep as Custom</button></form>
        <% } %>
        <details><summary>Create Fill</summary><form action="/admin/beverages/<%= item.id %>/create-fill" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Physical Keg <select name="kegId" required><option value="">Choose Keg</option><% for (const keg of it.availableKegs) { %><option value="<%= keg.id %>">Keg <%= keg.kegNumber %><% if (keg.label) { %> — <%= keg.label %><% } %></option><% } %></select></label><label>Fill date <input name="fillDate" type="date" /></label><button type="submit">Create Fill</button></form></details>
        <details><summary>Delete and review impact</summary><p><% if (item.deletionImpacts.length === 0) { %>No dependent records are reported.<% } else { %><% for (const impact of item.deletionImpacts) { %><%= impact.code %>: <%= impact.count %> <% } %><% } %></p><form action="/admin/beverages/<%= item.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Reason <input name="reason" /></label><button class="danger" type="submit">Permanently delete Beverage</button></form></details>
        </article>
      <% } %></div>
    <% } %>
  </section>
  <section aria-labelledby="brewfather-candidates-heading"><h2 id="brewfather-candidates-heading">Brewfather candidates</h2><% if (it.brewfatherCandidates.length === 0) { %><p>No unlinked cached batches are available. Refresh Brewfather from Integrations.</p><% } else { %><div class="resource-list"><% for (const candidate of it.brewfatherCandidates) { %><article class="resource-card"><h3><%= candidate.name %></h3><p><% if (candidate.number) { %>Batch <%= candidate.number %> · <% } %><%= candidate.status %><% if (candidate.style) { %> · <%= candidate.style %><% } %></p><form action="/admin/beverages/brewfather/link" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="sourceBatchId" value="<%= candidate.sourceBatchId %>" /><button type="submit">Link as Beverage</button></form></article><% } %></div><% } %></section>
  <section aria-labelledby="create-beverage-heading"><h2 id="create-beverage-heading">Create a Custom Beverage</h2><form action="/admin/beverages/create" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Name <input name="name" required /></label><label>Type <select name="beverageType"><option value="beer">Beer</option><option value="cider">Cider</option><option value="mead">Mead</option><option value="seltzer">Seltzer</option><option value="soda">Soda</option><option value="water">Water</option><option value="cocktail">Cocktail</option><option value="kombucha">Kombucha</option><option value="coffee">Coffee</option><option value="other">Other</option></select></label><label>Style <input name="style" /></label><label>ABV <input name="abv" type="number" min="0" max="100" step="0.1" /></label><label>Display color <input name="displayColor" pattern="#[0-9A-Fa-f]{6}" placeholder="#D97706" /></label><%~ include("/partials/fill-glass-picker", { label: "Fill Glass", name: "fillGlass", id: "create-fill-glass", selected: "", options: it.fillGlassOptions || [] }) %><label>Description <textarea name="description"></textarea></label><button type="submit">Create Beverage</button></form></section>
</main>
