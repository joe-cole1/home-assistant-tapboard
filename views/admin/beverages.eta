<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content">
  <h1>Beverages</h1>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section aria-labelledby="beverage-list-heading"><h2 id="beverage-list-heading">Beverage library</h2>
    <% if (it.beverages.length === 0) { %><p>No Beverages are configured.</p><% } else { %>
      <div class="resource-list"><% for (const item of it.beverages) { %><article class="resource-card"><h3><%= item.name %></h3><p><strong><%= item.ownershipType === "custom" ? "Custom" : "Brewfather linked" %></strong><% if (item.style) { %> · <%= item.style %><% } %><% if (typeof item.abv === "number") { %> · <%= item.abv %>% ABV<% } %></p>
      <% if (item.description) { %><p><%= item.description %></p><% } %>
      <% if (item.ownershipType === "custom") { %><details><summary>Edit</summary><form action="/admin/beverages/<%= item.id %>/update" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Name <input name="name" value="<%= item.name %>" required /></label><label>Type <input name="beverageType" value="<%= item.beverageType %>" required /></label><label>Style <input name="style" value="<%= item.style || "" %>" /></label><label>ABV <input name="abv" type="number" min="0" max="100" step="0.1" value="<%= typeof item.abv === "number" ? item.abv : "" %>" /></label><label>Display color <input name="displayColor" value="<%= item.displayColor || "" %>" pattern="#[0-9A-Fa-f]{6}" /></label><label>Description <textarea name="description"><%= item.description || "" %></textarea></label><label>Fill Glass <input name="fillGlass" value="<%= item.fillGlass || "" %>" /></label><button type="submit">Update Beverage</button></form></details><% } %>
      <% if (item.ownershipType === "brewfather") { %><form action="/admin/beverages/<%= item.id %>/unlink" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button type="submit">Unlink and keep as Custom</button></form><% } %>
      <details><summary>Delete and review impact</summary><p><% if (item.deletionImpacts.length === 0) { %>No dependent records are reported.<% } else { %><% for (const impact of item.deletionImpacts) { %><%= impact.code %>: <%= impact.count %> <% } %><% } %></p><form action="/admin/beverages/<%= item.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Reason <input name="reason" /></label><button class="danger" type="submit">Permanently delete Beverage</button></form></details>
      </article><% } %></div>
    <% } %>
  </section>
  <section aria-labelledby="brewfather-candidates-heading"><h2 id="brewfather-candidates-heading">Brewfather candidates</h2><% if (it.brewfatherCandidates.length === 0) { %><p>No unlinked cached batches are available. Refresh Brewfather from Integrations.</p><% } else { %><div class="resource-list"><% for (const candidate of it.brewfatherCandidates) { %><article class="resource-card"><h3><%= candidate.name %></h3><p><% if (candidate.number) { %>Batch <%= candidate.number %> · <% } %><%= candidate.status %><% if (candidate.style) { %> · <%= candidate.style %><% } %></p><form action="/admin/beverages/brewfather/link" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="sourceBatchId" value="<%= candidate.sourceBatchId %>" /><button type="submit">Link as Beverage</button></form></article><% } %></div><% } %></section>
  <section aria-labelledby="create-beverage-heading"><h2 id="create-beverage-heading">Create a Custom Beverage</h2><form action="/admin/beverages/create" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Name <input name="name" required /></label><label>Type <select name="beverageType"><option value="beer">Beer</option><option value="cider">Cider</option><option value="mead">Mead</option><option value="seltzer">Seltzer</option><option value="soda">Soda</option><option value="water">Water</option><option value="cocktail">Cocktail</option><option value="kombucha">Kombucha</option><option value="coffee">Coffee</option><option value="other">Other</option></select></label><label>Style <input name="style" /></label><label>ABV <input name="abv" type="number" min="0" max="100" step="0.1" /></label><label>Display color <input name="displayColor" pattern="#[0-9A-Fa-f]{6}" placeholder="#D97706" /></label><label>Description <textarea name="description"></textarea></label><button type="submit">Create Beverage</button></form><p>Brew Story and sensory guidance are not part of this page yet.</p></section>
</main>
