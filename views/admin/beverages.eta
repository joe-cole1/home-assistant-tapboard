<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content">
  <header class="page-header">
    <p class="eyebrow">Manage</p>
    <h1>Beverages</h1>
    <p class="muted">A searchable library of every beverage available to the tapboard.</p>
  </header>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section class="section-heading" aria-labelledby="beverage-library-heading">
    <div>
      <h2 id="beverage-library-heading">Beverage library</h2>
      <p class="muted"><%= it.pagination.total %> beverage<%= it.pagination.total === 1 ? "" : "s" %></p>
    </div>
    <a class="button primary button--small" href="/admin/beverages/new">Add beverage</a>
  </section>
  <form class="admin-search" method="get" action="/admin/beverages" role="search">
    <label for="beverage-search">Search by name, style, type, or source</label>
    <div class="admin-search__controls">
      <input id="beverage-search" name="q" type="search" value="<%= it.query %>" maxlength="80" />
      <button type="submit">Search</button>
      <% if (it.query) { %><a class="button secondary button--small" href="/admin/beverages">Clear</a><% } %>
    </div>
  </form>
  <% if (it.beverages.length === 0) { %>
    <section class="empty-state admin-card" aria-labelledby="beverage-empty-heading">
      <h2 id="beverage-empty-heading"><%= it.query ? "No matching beverages" : "Your beverage library is empty" %></h2>
      <p><%= it.query ? "Try a different search or clear the filter." : "Create a custom beverage to start building the library." %></p>
      <a class="button primary button--small" href="/admin/beverages/new"><%= it.query ? "Add a beverage" : "Create the first beverage" %></a>
    </section>
  <% } else { %>
    <div class="table-scroll">
      <table class="admin-table beverage-list">
        <caption class="sr-only">Beverage library</caption>
        <thead><tr><th scope="col">Beverage</th><th scope="col">Style</th><th scope="col">ABV</th><th scope="col">Source</th><th scope="col">Current use</th></tr></thead>
        <tbody>
          <% for (const beverage of it.beverages) { %>
            <tr class="beverage-list__row" data-row-href="/admin/beverages/<%= beverage.id %>">
              <th class="beverage-list__beverage-cell" scope="row">
                <div class="beverage-list__preview"><%~ include("/partials/fill-graphic", { tap: { id: `beverage-${beverage.id}`, graphic: beverage.graphic, title: beverage.name, accessibleLabel: `${beverage.name} vessel preview`, fillPercent: beverage.fillPercent, displayColor: beverage.displayColor, tapNumber: 0 } }) %></div>
                <a class="beverage-list__name" href="/admin/beverages/<%= beverage.id %>">
                  <svg class="beverage-color-cue" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><circle cx="5" cy="5" r="5"<% if (beverage.displayColor) { %> fill="<%= beverage.displayColor %>"<% } else { %> class="beverage-color-cue__fallback"<% } %> /></svg>
                  <span><%= beverage.name %></span>
                </a>
                <span class="beverage-list__type"><%= beverage.beverageType %><% if (beverage.fillGlass) { %> · <%= beverage.fillGlass %><% } %></span>
              </th>
              <td><%= beverage.style || "—" %></td>
              <td><%= beverage.abv === null ? "—" : `${beverage.abv}%` %></td>
              <td><span class="status-badge status-badge--muted"><%= beverage.source %></span></td>
              <td><%= beverage.currentUsage === 0 ? "Not in use" : `${beverage.currentUsage} active fill${beverage.currentUsage === 1 ? "" : "s"}` %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if (it.pagination.pageCount > 1) { %>
      <nav class="pagination" aria-label="Beverage pages">
        <% if (it.pagination.previousHref) { %><a class="button secondary button--small" href="<%= it.pagination.previousHref %>">Previous</a><% } %>
        <span>Page <%= it.pagination.page %> of <%= it.pagination.pageCount %></span>
        <% if (it.pagination.nextHref) { %><a class="button secondary button--small" href="<%= it.pagination.nextHref %>">Next</a><% } %>
      </nav>
    <% } %>
  <% } %>
  <% if (it.brewfatherCandidates && it.brewfatherCandidates.length > 0) { %>
    <section class="admin-card" aria-labelledby="brewfather-candidates-heading">
      <details class="admin-disclosure">
        <summary><span><strong id="brewfather-candidates-heading">Unlinked Brewfather batches</strong><small>Link a cached batch only when you are ready to manage it here.</small></span></summary>
        <div class="resource-list">
          <% for (const candidate of it.brewfatherCandidates) { %>
            <article class="resource-card"><h3><%= candidate.name %></h3><p class="muted"><% if (candidate.number) { %>Batch <%= candidate.number %> · <% } %><%= candidate.status %><% if (candidate.style) { %> · <%= candidate.style %><% } %></p><form action="/admin/beverages/brewfather/link" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="sourceBatchId" value="<%= candidate.sourceBatchId %>" /><button class="secondary" type="submit">Link as beverage</button></form></article>
          <% } %>
        </div>
      </details>
    </section>
  <% } %>
</main>
