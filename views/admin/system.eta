<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content" class="admin-page"><header class="page-header"><p class="eyebrow">Future feature</p><h1>System</h1><p>Operator diagnostics and lifecycle tools will live here.</p></header><%~ include("/partials/admin-messages", { page: it.page }) %><section class="admin-card" aria-labelledby="system-status-heading"><span class="status-badge status-badge--healthy">Online</span><h2 id="system-status-heading">System status</h2><dl class="summary-grid"><div><dt>Schema version</dt><dd><%= it.system.schemaVersion %></dd></div><div><dt>Public live displays</dt><dd><%= it.system.liveClients.public.clients %></dd></div><div><dt>Admin live displays</dt><dd><%= it.system.liveClients.admin.clients %></dd></div></dl><p class="muted">Advanced system administration, retention controls, diagnostics, and operator tooling are planned for a future issue.</p></section></main>
