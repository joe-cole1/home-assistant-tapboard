<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content"><h1>System</h1><%~ include("/partials/admin-messages", { page: it.page }) %><section><h2>Implemented system information</h2><dl class="metrics"><div><dt>Schema version</dt><dd><%= it.system.schemaVersion %></dd></div><div><dt>Public live displays</dt><dd><%= it.system.liveClients.public.clients %></dd></div><div><dt>Admin live displays</dt><dd><%= it.system.liveClients.admin.clients %></dd></div></dl><p>Complete system administration, session management, retention controls, diagnostics, and operator tooling are not yet available in this rebuild.</p></section></main>
