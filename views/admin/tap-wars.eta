<% layout("/layouts/admin", { page: it.page }) %><%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %><main id="main-content" class="admin-page"><header class="page-header"><p class="eyebrow">Future feature</p><h1>Tap Wars</h1><p>Compare pours and celebrate the busiest Taps when this feature is ready.</p></header><%~ include("/partials/admin-messages", { page: it.page }) %><section class="admin-card placeholder-card" aria-labelledby="tap-wars-placeholder"><span class="status-badge status-badge--muted">Planned</span><h2 id="tap-wars-placeholder">Tap Wars is not available yet</h2><p class="muted">No scoring, ranking, or historical data is being collected by this placeholder.</p><a class="button secondary" href="/admin/overview">Return to Overview</a></section></main>
