<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<% const data = it.tapWars || {}; const current = data.current || null; const published = data.published || null; const publicVisible = data.publicVisible || null; const eligible = data.eligible || []; const history = data.history || []; const total = (war) => Number.isFinite(war?.totalVotes) ? war.totalVotes : (war?.competitors || []).reduce((sum, side) => sum + (side.voteCount || 0), 0); const publicSide = (side) => publicVisible?.id === current?.id ? publicVisible[`side${side}`] : null; const resultLabel = (war) => { if (war?.result === "tie") return "Tie"; const side = war?.result === "side1" ? 1 : war?.result === "side2" ? 2 : null; return side ? (war.competitors || []).find((competitor) => competitor.side === side)?.adminBeverageTitle + " wins" : "Result pending"; }; %>
<main id="main-content" class="admin-page tap-wars-admin" data-admin-tap-wars<% if (current) { %> data-current-id="<%= current.id %>" data-current-status="<%= current.status %>"<% } %><% if (published) { %> data-published-id="<%= published.id %>"<% } %>>
  <header class="page-header">
    <p class="eyebrow">Live voting</p>
    <h1>Tap Wars</h1>
    <p>Run a simple public head-to-head between two currently assigned Taps. Votes are counted exactly as received.</p>
  </header>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <output class="tap-wars-live-status sr-only" aria-live="polite" data-tap-wars-live-status></output>

  <% if (current) { %>
    <section class="admin-card tap-wars-current tap-wars-current--<%= current.status %>" aria-labelledby="tap-wars-current-title">
      <div class="section-heading tap-wars-current__heading"><div><p class="eyebrow"><%= current.status === "active" ? "Now accepting votes" : "Needs attention" %></p><h2 id="tap-wars-current-title"><%= current.status === "active" ? "Current Tap War" : "Tap War paused" %></h2><p class="muted">Started <time datetime="<%= current.startedAt %>"><%= current.startedAt || "Unknown" %></time></p></div><span class="status-badge<%= current.status === "active" ? "" : " status-badge--warning" %>" data-war-status><%= current.status === "active" ? "Voting open" : "Voting paused" %></span></div>
      <% if (current.status === "paused") { const unavailable = current.competitors.filter((side) => !side.eligible); %><aside class="tap-wars-attention" aria-label="Why voting is paused"><strong>Voting is paused until both original competitors are eligible again.</strong><% if (unavailable.length > 0) { %><ul><% for (const side of unavailable) { %><li>Tap <%= side.tapNumber %> — <%= side.adminBeverageTitle %>: <%= side.unavailableReason || "Eligibility changed." %></li><% } %></ul><% } %></aside><% } %>
      <div class="tap-wars-matchup" data-war-matchup><% for (const side of current.competitors) { const safe = publicSide(side.side); %><article class="tap-wars-competitor" data-war-side="<%= side.side %>"><p class="eyebrow">Side <%= side.side %> · Tap <%= side.tapNumber %></p><h3><%= side.adminBeverageTitle %></h3><p class="tap-wars-public-title">Public: <span data-war-public-title="<%= side.side %>"><%= safe?.title || "Mystery Tap" %></span></p><dl class="tap-wars-score"><div><dt>Votes</dt><dd data-war-count="<%= side.side %>"><%= side.voteCount %></dd></div><div><dt>Share</dt><dd data-war-percentage="<%= side.side %>"><%= side.percentage === null || side.percentage === undefined ? "—" : `${side.percentage}%` %></dd></div></dl><div class="tap-wars-meter" aria-label="Tap <%= side.tapNumber %> has <%= side.voteCount %> votes"><span data-war-meter="<%= side.side %>" style="width: <%= side.percentage || 0 %>%"></span></div></article><% } %></div>
      <div class="tap-wars-totals" aria-live="polite"><strong data-war-total><%= total(current) %></strong> total vote<%= total(current) === 1 ? "" : "s" %> · <span data-war-leader><%= current.isTie ? "Tied" : current.leaderSide ? `Side ${current.leaderSide} leads` : "No leader yet" %></span></div>
      <div class="card-actions tap-wars-actions"><% if (current.status === "paused" && data.canResume) { %><form action="/admin/tap-wars/<%= current.id %>/resume" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button class="primary button--small" type="submit">Resume Tap War</button></form><% } %><form action="/admin/tap-wars/<%= current.id %>/stop" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button class="secondary button--small" type="submit">Stop Tap War</button></form></div>
    </section>
  <% } else { %>
    <section class="admin-card tap-wars-start" aria-labelledby="tap-wars-start-title"><div class="section-heading"><div><p class="eyebrow">Next matchup</p><h2 id="tap-wars-start-title">Start a Tap War</h2><p class="muted">Choose two different eligible Tap assignments. Server validation remains authoritative.</p></div></div><form class="admin-form tap-wars-start__form<% if (eligible.length < 2) { %> tap-wars-start__form--blocked<% } %>" action="/admin/tap-wars/start" method="post" data-tap-wars-start><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><% for (const side of [1, 2]) { %><label>Side <%= side %><select name="competitor<%= side %>AssignmentId" required data-tap-wars-selector="<%= side %>"<% if (eligible.length < 2) { %> disabled<% } %>><option value="">Choose a Tap</option><% for (const item of eligible) { %><option value="<%= item.assignmentId %>" data-title="<%= item.preview?.title || "Mystery Tap" %>" data-tap-number="<%= item.preview?.tapNumber || item.tapNumber %>">Tap <%= item.preview?.tapNumber || item.tapNumber %> · <%= item.preview?.title || "Mystery Tap" %></option><% } %></select></label><% } %><% if (eligible.length < 2) { %><div class="tap-wars-setup" role="note"><strong>Two eligible Tap assignments are needed before voting can start.</strong><p>Enable two non-retired Taps and give each one an active Filled Keg. The server will re-check eligibility when you start a war.</p><div class="tap-wars-setup__links"><a class="button primary button--small" href="/admin/keg-room">Set up Keg Room</a><a class="button secondary button--small" href="/admin/taps">Manage Taps</a></div></div><% } else { %><div class="tap-wars-preview" aria-live="polite" data-tap-wars-preview><p>Select two Tap assignments to preview the exact public-safe matchup.</p></div><% } %><button class="primary button--small" type="submit" data-tap-wars-start-submit<% if (eligible.length < 2) { %> disabled<% } %>>Start Tap War</button></form></section>
  <% } %>

  <% if (published) { %>
    <section class="admin-card tap-wars-published" aria-labelledby="tap-wars-published-title"><div class="section-heading"><div><p class="eyebrow">Visible on the public Tapboard</p><h2 id="tap-wars-published-title">Published result</h2><p class="muted">Completed <time datetime="<%= published.completedAt %>"><%= published.completedAt || "Unknown" %></time></p></div><span class="status-badge">Published</span></div><p class="tap-wars-result"><strong><%= resultLabel(published) %></strong> · <%= total(published) %> final vote<%= total(published) === 1 ? "" : "s" %></p><div class="tap-wars-result-grid"><% for (const side of published.competitors) { const currentPublic = publicVisible?.id === published.id ? publicVisible[`side${side.side}`] : null; %><article><h3>Tap <%= side.tapNumber %> · <%= side.adminBeverageTitle %></h3><p>Currently public: <%= currentPublic?.title || "Mystery Tap" %></p><p>Public title at completion: <%= side.side === 1 ? published.completionPublicTitleSide1 || "Mystery Tap" : published.completionPublicTitleSide2 || "Mystery Tap" %></p><strong><%= side.voteCount %> · <%= side.percentage === null || side.percentage === undefined ? "—" : `${side.percentage}%` %></strong></article><% } %></div><form action="/admin/tap-wars/<%= published.id %>/dismiss" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button class="secondary button--small" type="submit">Dismiss public result</button></form></section>
  <% } %>

  <section class="admin-card tap-wars-history" aria-labelledby="tap-wars-history-title"><div class="section-heading"><div><p class="eyebrow">Read-only record</p><h2 id="tap-wars-history-title">Tap War history</h2></div><span class="status-badge status-badge--muted"><%= history.length %></span></div><% if (history.length === 0) { %><p class="muted">Completed Tap Wars will appear here, newest first.</p><% } else { %><div class="table-scroll"><table class="admin-table tap-wars-history-table"><caption class="sr-only">Completed Tap Wars, newest first</caption><thead><tr><th scope="col">Completed</th><th scope="col">Matchup</th><th scope="col">Final score</th><th scope="col">Result</th></tr></thead><tbody><% for (const war of history) { %><tr><td><time datetime="<%= war.completedAt %>"><%= war.completedAt || "Unknown" %></time><br /><small>Started <%= war.startedAt || "Unknown" %></small></td><td><% for (const side of war.competitors) { %><div><strong>Tap <%= side.tapNumber %></strong> · <%= side.adminBeverageTitle %><br /><small>Public snapshot: <%= side.side === 1 ? war.completionPublicTitleSide1 || "Mystery Tap" : war.completionPublicTitleSide2 || "Mystery Tap" %></small></div><% } %></td><td><% for (const side of war.competitors) { %><div>Side <%= side.side %>: <%= side.voteCount %> (<%= side.percentage === null || side.percentage === undefined ? "—" : `${side.percentage}%` %>)</div><% } %></td><td><strong><%= resultLabel(war) %></strong></td></tr><% } %></tbody></table></div><% } %></section>
</main>
<script type="module" src="/assets/js/admin-tap-wars.js"></script>
