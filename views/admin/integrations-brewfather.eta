<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content">
  <header class="page-header">
    <p class="eyebrow"><a href="/admin/integrations">Integrations</a> / Beverage source</p>
    <h1>Brewfather</h1>
    <p>Connect Brewfather to import beverage data. Stored credentials are never shown.</p>
  </header>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section class="admin-card" aria-labelledby="brewfather-status-heading">
    <% const connectionLabel = !it.brewfather.configured ? "Not configured" : !it.brewfather.enabled ? "Disabled" : ({ healthy: "Connected", unknown: "Awaiting verification", partial: "Refresh incomplete", disconnected: "Disconnected", disabled: "Disabled" }[it.brewfather.connectionState] || "Awaiting verification"); %>
    <div class="section-heading"><div><h2 id="brewfather-status-heading">Connection status</h2><p class="muted">Read-only summary of the current integration.</p></div><span class="status-badge status-badge--<%= connectionLabel === "Connected" ? "healthy" : "muted" %>"><%= connectionLabel %></span></div>
    <% if (it.brewfather.credentialStorage && !it.brewfather.credentialStorage.available) { %>
    <p role="alert">Credential storage is unavailable. Configure a valid TAPBOARD_SECRET_KEY on the server before saving API keys. This server key is separate from your Brewfather API key. If credentials were stored previously, restore the original server key or use the documented key rotation procedure.</p>
    <% } %>
    <dl class="metrics metrics--compact"><div><dt>Account</dt><dd><%= it.brewfather.configured ? "Configured" : "Not configured" %></dd></div><div><dt>API key</dt><dd><%= it.brewfather.apiKeyConfigured ? "Stored" : "Not stored" %></dd></div><div><dt>Linked beverages</dt><dd><%= it.brewfather.linkedBeverages %></dd></div><div><dt>Import candidates</dt><dd><%= it.brewfather.candidates %></dd></div></dl>
  </section>
  <section class="admin-card" aria-labelledby="brewfather-settings-heading">
    <details class="admin-disclosure">
      <summary><span><strong id="brewfather-settings-heading">Connection settings</strong><small>Update the account or replace the stored API key.</small></span></summary>
      <form action="/admin/integrations/brewfather" method="post">
        <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
        <label>User ID <input name="userId" autocomplete="off" maxlength="120" required /></label>
        <label>Replace API key <input name="apiKey" type="password" autocomplete="new-password" maxlength="256" /></label>
        <label>Enabled <select name="enabled"><option value="true"<% if (it.brewfather.enabled) { %> selected<% } %>>Enabled</option><option value="false"<% if (!it.brewfather.enabled) { %> selected<% } %>>Disabled</option></select></label>
        <button type="submit">Save Brewfather configuration</button>
      </form>
    </details>
  </section>
  <section class="admin-card" aria-labelledby="brewfather-actions-heading">
    <p class="status-line"><strong>Last data update:</strong> <% if (it.brewfather.lastDataUpdateAt) { %><time datetime="<%= it.brewfather.lastDataUpdateAt %>"><%= it.brewfather.lastDataUpdateAtLabel %></time><% } else { %>Never<% } %></p>
    <details class="admin-disclosure">
      <summary><span><strong id="brewfather-actions-heading">Maintenance</strong><small>Refresh imported data or remove the stored credential.</small></span></summary>
      <div class="action-group">
        <% if (it.brewfather.configured) { %><form action="/admin/integrations/brewfather/sync" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button type="submit">Refresh Brewfather now</button></form><% } %>
        <% if (it.brewfather.apiKeyConfigured) { %><form action="/admin/integrations/brewfather/remove-key" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button class="danger" type="submit">Remove stored API key</button></form><% } %>
      </div>
    </details>
  </section>
</main>
