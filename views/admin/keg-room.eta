<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content">
  <div class="page-header">
    <p class="eyebrow">Service flow</p>
    <h1>Keg Room</h1>
    <p class="muted">Keep Filled Kegs moving from available to On Deck to On Tap.</p>
  </div>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <div class="page-actions">
    <a class="button primary button--small" href="<%= it.newFillHref %>">Fill a Keg</a>
    <a class="button secondary button--small" href="<%= it.inventoryHref %>">Physical Kegs</a>
    <a class="button secondary button--small" href="<%= it.historyHref %>">View history</a>
  </div>
  <section class="admin-card" aria-labelledby="keg-room-filters">
    <div class="section-heading"><div><h2 id="keg-room-filters">Find a Filled Keg</h2><p class="muted"><%= it.pagination.total %> result<%= it.pagination.total === 1 ? "" : "s" %></p></div></div>
    <form class="admin-form admin-form--inline keg-room-filter-form" method="get" action="/admin/keg-room" role="search">
      <label>Search <input type="search" name="q" value="<%= it.query.q %>" maxlength="80" placeholder="Beverage, Keg, or Tap" /></label>
      <label>Show <select name="state"><option value="active"<% if (it.query.state === "active") { %> selected<% } %>>Active Kegs</option><option value="available"<% if (it.query.state === "available") { %> selected<% } %>>Available</option><option value="on_deck"<% if (it.query.state === "on_deck") { %> selected<% } %>>On Deck</option><option value="on_tap"<% if (it.query.state === "on_tap") { %> selected<% } %>>On Tap</option><option value="ended"<% if (it.query.state === "ended") { %> selected<% } %>>History</option><option value="all"<% if (it.query.state === "all") { %> selected<% } %>>All</option></select></label>
      <label>Sort <select name="sort"><option value="state"<% if (it.query.sort === "state") { %> selected<% } %>>State</option><option value="name"<% if (it.query.sort === "name") { %> selected<% } %>>Beverage</option><option value="fill_date"<% if (it.query.sort === "fill_date") { %> selected<% } %>>Fill date</option><option value="keg"<% if (it.query.sort === "keg") { %> selected<% } %>>Keg number</option><option value="updated"<% if (it.query.sort === "updated") { %> selected<% } %>>Recently updated</option></select></label>
      <button class="secondary button--small" type="submit">Apply</button>
    </form>
  </section>
  <% for (const section of it.sections) { %>
    <section class="keg-room-section<%= section.id === "on-deck" ? " on-deck-queue" : "" %>" aria-labelledby="keg-room-section-<%= section.id %>"<% if (section.id === "on-deck") { %> data-admin-reorder<% } %>>
      <% const sectionEyebrow = section.id === "available" ? "Ready to serve" : section.id === "on-deck" ? "Queued next" : section.id === "on-tap" ? "Serving now" : "Audit trail"; %>
      <div class="section-heading"><div><p class="eyebrow"><%= sectionEyebrow %></p><h2 id="keg-room-section-<%= section.id %>"><%= section.title %></h2></div><span class="status-badge"><%= section.items.length %></span></div>
      <% if (section.id === "on-deck") { %><div class="reorder-enhancement"><p class="muted">Drag the handle to reorder, or use the Move up/down buttons.</p><form data-reorder-form action="/admin/fills/reorder-on-deck" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="fillIds" value="<%= section.items.map((item) => item.id).join(",") %>" /></form><output data-reorder-status aria-live="polite"></output></div><% } %>
      <% if (section.items.length === 0) { %><p class="muted">No Filled Kegs in this state.</p><% } else { %>
        <div class="table-scroll">
          <table class="admin-table keg-room-table">
            <caption class="sr-only"><%= section.title %> Filled Kegs</caption>
            <thead><tr><th scope="col">Filled Keg</th><th scope="col">Physical Keg</th><th scope="col">Tap or queue</th><th scope="col">Remaining estimate</th><th scope="col">Actions</th></tr></thead>
            <tbody<% if (section.id === "on-deck") { %> data-reorder-list<% } %>>
              <% for (const fill of section.items) { %>
                <tr data-fill-id="<%= fill.id %>" data-fill-state="<%= fill.state %>"<% if (fill.state === "on_deck") { %> data-keg-room-reorder data-reorder-item data-order="<%= fill.onDeckOrder || 0 %>"<% } %>>
                  <th scope="row"><div class="keg-room-table__fill"><div class="beverage-list__preview"><%~ include("/partials/fill-graphic", { tap: { id: fill.id, graphic: fill.graphic, title: fill.beverageName, accessibleLabel: `${fill.beverageName} Filled Keg`, fillPercent: fill.fillPercent, displayColor: fill.displayColor, tapNumber: fill.tapNumber || 0 } }) %></div><a class="beverage-list__name" href="/admin/keg-room/fills/<%= fill.id %>"><%= fill.beverageName %></a><span class="beverage-list__type"><span class="status-badge status-badge--<%= fill.state %>"><%= fill.stateLabel %></span></span></div></th>
                  <td><a href="/admin/keg-room/kegs/<%= fill.kegId || "" %>">Keg <%= fill.kegNumber %><% if (fill.kegLabel) { %> — <%= fill.kegLabel %><% } %></a></td>
                  <td><% if (fill.tapNumber) { %>Tap <%= fill.tapNumber %><% } else if (fill.queuePosition) { %>Queue position <%= fill.queuePosition %><% } else { %>Not queued<% } %></td>
                  <td><%= fill.remainingEstimate %></td>
                  <td><div class="card-actions keg-room-table__actions">
                  <% if (fill.state === "available") { %>
                    <form action="/admin/fills/<%= fill.id %>/on-deck" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button class="primary button--small" type="submit">Put On Deck</button></form>
                  <% } else if (fill.state === "on_deck") { %>
                    <button class="secondary button--small reorder-handle" type="button" data-reorder-handle draggable="true" aria-label="Drag to reorder <%= fill.beverageName %>">☷ <span class="sr-only">Drag to reorder</span></button>
                    <a class="button primary button--small" href="/admin/keg-room/fills/<%= fill.id %>">Assign to a Tap</a>
                    <div class="reorder-actions" data-keg-room-reorder-controls>
                      <form action="/admin/fills/<%= fill.id %>/move" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button class="secondary button--small" name="direction" value="up" type="submit">Move up</button></form>
                      <form action="/admin/fills/<%= fill.id %>/move" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button class="secondary button--small" name="direction" value="down" type="submit">Move down</button></form>
                    </div>
                  <% } else if (fill.state === "on_tap") { %>
                    <details><summary>Kick Keg</summary><p class="muted">This ends the Filled Keg and closes its active Tap assignment.</p><form action="/admin/fills/<%= fill.id %>/kick" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Reason <input name="reason" maxlength="255" /></label><button class="danger button--small" type="submit">Kick Keg</button></form></details>
                  <% } else { %>
                    <a class="button secondary button--small" href="/admin/keg-room/fills/<%= fill.id %>">View Filled Keg</a>
                  <% } %>
                  </div></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  <% } %>
  <% if (it.pagination.previousHref || it.pagination.nextHref) { %><nav class="pagination" aria-label="Keg Room pages"><% if (it.pagination.previousHref) { %><a class="button secondary button--small" href="<%= it.pagination.previousHref %>">Previous</a><% } %><span>Page <%= it.pagination.page %> of <%= it.pagination.pageCount %></span><% if (it.pagination.nextHref) { %><a class="button secondary button--small" href="<%= it.pagination.nextHref %>">Next</a><% } %></nav><% } %>
</main>
