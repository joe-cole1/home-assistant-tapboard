<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<% const fontOptions = [
  ["system", "System"],
  ["outfit", "Outfit"],
  ["inter", "Inter"],
  ["roboto", "Roboto"],
  ["fredoka", "Fredoka"],
  ["montserrat", "Montserrat"],
  ["barlow_condensed", "Barlow Condensed"],
  ["bree_serif", "Bree Serif"],
  ["bungee", "Bungee"],
  ["rye", "Rye"],
  ["special_elite", "Special Elite"],
]; %>
<main id="main-content" class="display-settings-page">
  <header class="page-header"><p class="eyebrow"><a href="/admin/display">Display</a> / Shared defaults</p><h1>Shared defaults</h1><p>Changes here are inherited by every display without an explicit local override.</p></header>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section class="admin-card" aria-labelledby="shared-settings-heading">
    <h2 id="shared-settings-heading">Shared presentation</h2>
    <form class="display-settings-form" data-shared-display-form data-autosave="apply" data-autosave-resource="display:shared" action="/admin/display/shared" method="post">
      <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="expectedRevision" value="<%= it.sharedDisplay.revision %>" />
      <label>Tapboard name <input name="tapboardName" value="<%= it.sharedDisplay.tapboardName %>" maxlength="80" required /></label>
      <label>Theme <select name="theme"><% for (const value of ["modern_dark","warm_pub","cyberpunk","light_minimal"]) { %><option value="<%= value %>"<% if (it.sharedDisplay.theme === value) { %> selected<% } %>><%= value.replaceAll("_", " ") %></option><% } %></select></label>
      <label>Font <select name="font"><% for (const [value, label] of fontOptions) { %><option value="<%= value %>"<% if (it.sharedDisplay.font === value) { %> selected<% } %>><%= label %></option><% } %></select></label>
      <div class="display-font-previews" aria-label="Font previews"><% for (const [value, label] of fontOptions) { %><div class="display-font-preview display-font-preview--<%= value %>"><strong><%= label %></strong><span>Hazardous Brews</span><small>Northbound Pale Ale · 5.0%</small></div><% } %></div>
      <label>Accent <input name="accent" value="<%= it.sharedDisplay.accent %>" pattern="#[0-9a-f]{6}|amber|sky|rose|cyan|tan|orange|blue" maxlength="7" required /><span class="display-accent-picker-inline"><input type="color" data-accent-color value="<%= /^#[0-9a-f]{6}$/u.test(it.sharedDisplay.accent) ? it.sharedDisplay.accent : '#fbc02d' %>" aria-label="Custom accent color" /></span><span class="display-accent-swatches" aria-label="Named accents"><% for (const value of ["amber","sky","rose","cyan","tan","orange","blue"]) { %><button type="button" class="display-accent-swatch display-accent-swatch--<%= value %>" data-accent-preset="<%= value %>" aria-label="<%= value %>" title="<%= value %>"></button><% } %></span></label>
      <label>Units <select name="unitSystem"><option value="us"<% if (it.sharedDisplay.unitSystem === "us") { %> selected<% } %>>US customary</option><option value="metric"<% if (it.sharedDisplay.unitSystem === "metric") { %> selected<% } %>>Metric</option></select></label>
      <label class="switch-field">Serving temperature <input class="switch-input" type="checkbox" name="showServingTemperature" value="true"<% if (it.sharedDisplay.showServingTemperature) { %> checked<% } %> /><span class="switch-track" aria-hidden="true"></span><span class="switch-state"><%= it.sharedDisplay.showServingTemperature ? "Shown" : "Hidden" %></span></label>
      <label>More than six Taps <select name="layoutMode"><option value="scroll"<% if (it.sharedDisplay.layoutMode === "scroll") { %> selected<% } %>>Responsive and scroll</option><option value="rotation"<% if (it.sharedDisplay.layoutMode === "rotation") { %> selected<% } %>>Automatic rotation</option></select></label>
      <div class="form-actions"><button type="submit">Apply shared defaults</button><output class="autosave-status" data-autosave-status aria-live="polite">Apply to update shared defaults.</output></div>
    </form>
  </section>
  <section class="admin-card display-preview-card" aria-labelledby="display-preview-heading"><div class="section-heading"><div><h2 id="display-preview-heading">Preview</h2><p class="muted">A fixed presentation sample. It does not read or modify domain data.</p></div></div><div class="display-preview" data-display-preview data-preview-theme="<%= it.sharedDisplay.theme %>" data-preview-accent="<%= it.sharedDisplay.accent %>" data-preview-font="<%= it.sharedDisplay.font %>"><div class="display-preview__header"><span>Hazardous Brews</span><span class="status-badge">Connected</span></div><article class="display-preview__tap"><span class="display-preview__number">1</span><div><h3>Northbound Pale Ale</h3><p>5.0% · American Pale Ale</p><dl><div><dt>IBU</dt><dd>42</dd></div><div><dt>OG</dt><dd>1.054</dd></div><div><dt>FG</dt><dd>1.012</dd></div></dl><p>Citrus peel, soft pine, and a crisp finish.</p></div><div class="display-preview__glass" aria-hidden="true"></div></article></div></section>
  <% if (it.tapCardSettings) { %><section class="admin-card" id="tap-card-settings" aria-labelledby="tap-card-settings-heading"><h2 id="tap-card-settings-heading">Tap-card metrics</h2><p>These defaults control what public cards show. A Tap can override metric visibility on its own detail page.</p><form class="display-settings-form" data-autosave="apply" data-autosave-resource="display:tap-card" action="/admin/display/tap-card" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="expectedRevision" value="<%= it.tapCardSettings.revision %>" /><fieldset><legend>Metrics shown</legend><div class="switch-grid"><% for (const metric of [["showAbv","ABV"],["showIbu","IBU"],["showOg","OG"],["showFg","FG"],["showSrm","SRM"]]) { %><label class="switch-field"><%= metric[1] %><input class="switch-input" type="checkbox" name="<%= metric[0] %>" value="true"<% if (it.tapCardSettings[metric[0]]) { %> checked<% } %> /><span class="switch-track" aria-hidden="true"></span></label><% } %></div></fieldset><label>Remaining display <select name="remainingMode"><option value="percent"<% if (it.tapCardSettings.remainingMode === "percent") { %> selected<% } %>>% remaining</option><option value="pints"<% if (it.tapCardSettings.remainingMode === "pints") { %> selected<% } %>>Pints remaining</option><option value="pours"<% if (it.tapCardSettings.remainingMode === "pours") { %> selected<% } %>>Pours remaining</option><option value="volume"<% if (it.tapCardSettings.remainingMode === "volume") { %> selected<% } %>>Volume</option></select></label><button type="submit">Save Tap-card settings</button><output class="autosave-status" data-autosave-status aria-live="polite">Apply to update shared card defaults.</output></form></section><% } %>
</main>
<script type="module" src="/assets/js/admin-display.js"></script>
