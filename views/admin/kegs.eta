<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content"><h1>Kegs</h1><%~ include("/partials/admin-messages", { page: it.page }) %>
  <section aria-labelledby="keg-list"><h2 id="keg-list">Physical inventory</h2><% if (it.kegs.length === 0) { %><p>No physical Kegs are configured.</p><% } else { %><div class="resource-list"><% for (const keg of it.kegs) { %><article class="resource-card"><h3>Keg <%= keg.kegNumber %><% if (keg.label) { %> — <%= keg.label %><% } %></h3><p><%= keg.capacityMl %> mL · tare <%= keg.currentTareG %> g · <%= keg.isActive ? "Active" : "Inactive" %></p><p>Current Fill: <%= keg.currentFill || "None" %></p><details><summary>History</summary><p><%= keg.tareHistory.length %> tare correction(s); <%= keg.maintenanceHistory.length %> maintenance record(s).</p><ul><% for (const item of keg.maintenanceHistory) { %><li><%= item.maintenanceType %> — <time datetime="<%= item.recordedAt %>"><%= item.recordedAt %></time></li><% } %></ul></details><details><summary>Edit or correct</summary><form action="/admin/kegs/<%= keg.id %>/update" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Number <input name="kegNumber" type="number" min="1" value="<%= keg.kegNumber %>" required /></label><label>Label <input name="label" value="<%= keg.label || "" %>" /></label><label>Capacity (mL) <input name="capacityMl" type="number" min="1" value="<%= keg.capacityMl %>" required /></label><label>Tare (g) <input name="currentTareG" type="number" min="0" step="1" value="<%= keg.currentTareG %>" required /></label><label>Status <select name="isActive"><option value="true"<% if (keg.isActive) { %> selected<% } %>>Active</option><option value="false"<% if (!keg.isActive) { %> selected<% } %>>Inactive</option></select></label><label>Correction reason <input name="reason" /></label><button type="submit">Update Keg</button></form></details><details><summary>Maintenance</summary><form action="/admin/kegs/<%= keg.id %>/maintenance" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Type <input name="maintenanceType" required /></label><label>Notes <textarea name="notes"></textarea></label><button type="submit">Record maintenance</button></form></details><details><summary>Delete and review impact</summary><p><% for (const impact of keg.deletionImpacts) { %><%= impact.code %>: <%= impact.count %> <% } %></p><form action="/admin/kegs/<%= keg.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Reason <input name="reason" /></label><button class="danger" type="submit">Permanently delete Keg</button></form></details></article><% } %></div><% } %></section>
  <section aria-labelledby="create-keg"><h2 id="create-keg">Add physical Keg</h2><form action="/admin/kegs/create" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Number <input name="kegNumber" type="number" min="1" required /></label><label>Label <input name="label" /></label><label>Capacity (mL) <input name="capacityMl" type="number" min="1" required /></label><label>Tare (g) <input name="currentTareG" type="number" min="0" step="1" /></label><input type="hidden" name="isActive" value="true" /><button type="submit">Create Keg</button></form></section>
</main>
