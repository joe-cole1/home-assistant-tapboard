<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content"><h1>Fills</h1><%~ include("/partials/admin-messages", { page: it.page }) %>
  <section aria-labelledby="fill-list"><h2 id="fill-list">Fill lifecycle</h2><% if (it.fills.length === 0) { %><p>No Fills are recorded.</p><% } else { %>
    <table><thead><tr><th scope="col">Beverage</th><th scope="col">Keg</th><th scope="col">Date</th><th scope="col">State</th><th scope="col">Actions</th></tr></thead><tbody>
    <% for (const fill of it.fills) { %><tr><th scope="row"><%= fill.beverageName %></th><td>Keg <%= fill.kegNumber %><% if (fill.kegLabel) { %> — <%= fill.kegLabel %><% } %></td><td><%= fill.fillDate %></td><td><%= fill.state === "on_deck" ? ("On Deck #" + fill.onDeckOrder) : fill.state.replace("_", " ") %></td><td class="actions">
      <% if (fill.state === "available") { %><form action="/admin/fills/<%= fill.id %>/on-deck" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button type="submit">Put On Deck</button></form><% } %>
      <% if (fill.state === "on_deck") { %><form action="/admin/fills/<%= fill.id %>/move" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button name="direction" value="up" type="submit">Move up</button><button name="direction" value="down" type="submit">Move down</button></form><form action="/admin/fills/<%= fill.id %>/remove-on-deck" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button type="submit">Remove from On Deck</button></form><% } %>
      <% if (fill.state !== "ended") { %><details><summary>Kick Keg</summary><form action="/admin/fills/<%= fill.id %>/kick" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Reason <input name="reason" /></label><button class="danger" type="submit">End Fill</button></form></details><% } %>
      <% if (fill.state === "ended") { %><details><summary>Delete permanently</summary><form action="/admin/fills/<%= fill.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Reason <input name="reason" /></label><button class="danger" type="submit">Delete Fill</button></form></details><% } %>
    </td></tr><% } %></tbody></table><% } %>
  </section>
  <section aria-labelledby="create-fill"><h2 id="create-fill">Create Fill</h2><form action="/admin/fills/create" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Beverage <select name="beverageId" required><option value="">Choose Beverage</option><% for (const beverage of it.beverages) { %><option value="<%= beverage.id %>"><%= beverage.name %></option><% } %></select></label><label>Physical Keg <select name="kegId" required><option value="">Choose Keg</option><% for (const keg of it.kegs) { %><option value="<%= keg.id %>">Keg <%= keg.kegNumber %><% if (keg.label) { %> — <%= keg.label %><% } %></option><% } %></select></label><label>Fill date <input name="fillDate" type="date" /></label><button type="submit">Create Fill</button></form></section>
</main>
