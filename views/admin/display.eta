<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content"><h1>Display</h1><%~ include("/partials/admin-messages", { page: it.page }) %>
  <p class="inheritance"><strong>Shared defaults</strong> → <strong>This display’s local overrides</strong></p>
  <section aria-labelledby="shared-display"><h2 id="shared-display">Shared defaults</h2><p>Used by every display unless that browser has an explicit local override.</p><form action="/admin/display/shared" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="expectedRevision" value="<%= it.sharedDisplay.revision %>" /><label>Tapboard name <input name="tapboardName" value="<%= it.sharedDisplay.tapboardName %>" maxlength="80" required /></label>
    <label>Theme <select name="theme"><% for (const value of ["modern_dark","warm_pub","cyberpunk","light_minimal"]) { %><option value="<%= value %>"<% if (it.sharedDisplay.theme === value) { %> selected<% } %>><%= value %></option><% } %></select></label>
    <label>Font <select name="font"><% for (const value of ["system","outfit","inter","roboto","fredoka","montserrat"]) { %><option value="<%= value %>"<% if (it.sharedDisplay.font === value) { %> selected<% } %>><%= value %></option><% } %></select></label>
    <label>Accent <select name="accent"><% for (const value of ["amber","sky","rose","cyan","tan","orange","blue"]) { %><option value="<%= value %>"<% if (it.sharedDisplay.accent === value) { %> selected<% } %>><%= value %></option><% } %></select></label>
    <label>Units <select name="unitSystem"><option value="us"<% if (it.sharedDisplay.unitSystem === "us") { %> selected<% } %>>US customary</option><option value="metric"<% if (it.sharedDisplay.unitSystem === "metric") { %> selected<% } %>>Metric</option></select></label>
    <label>Serving temperature <select name="showServingTemperature"><option value="true"<% if (it.sharedDisplay.showServingTemperature) { %> selected<% } %>>Show</option><option value="false"<% if (!it.sharedDisplay.showServingTemperature) { %> selected<% } %>>Hide</option></select></label>
    <label>More than six Taps <select name="layoutMode"><option value="scroll"<% if (it.sharedDisplay.layoutMode === "scroll") { %> selected<% } %>>Responsive and scroll</option><option value="rotation"<% if (it.sharedDisplay.layoutMode === "rotation") { %> selected<% } %>>Automatic rotation</option></select></label><button type="submit">Save shared defaults</button></form></section>
  <section aria-labelledby="local-display"><h2 id="local-display">This display</h2><p>These overrides are stored only in this browser. “Inherit” follows future shared-default changes.</p><form data-display-preferences></form><button type="button" data-reset-preferences>Reset this display to inherit</button><p data-display-preference-status role="status"></p></section>
</main><script type="module" src="/assets/js/admin-display.js"></script>
