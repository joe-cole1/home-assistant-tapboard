<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content" class="display-landing">
  <header class="page-header"><p class="eyebrow">Configure</p><h1>Display</h1><p>Choose what every Tapboard display inherits, then tune a single browser when needed.</p></header>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <div class="display-settings-grid">
    <section class="admin-card" aria-labelledby="shared-display-card"><h2 id="shared-display-card">Shared defaults</h2><p>Applied to every display until a browser has an explicit local override.</p><dl class="key-value-list"><div><dt>Site name</dt><dd><%= it.sharedDisplay.tapboardName %></dd></div><div><dt>Theme</dt><dd><%= it.sharedDisplay.theme.replaceAll("_", " ") %></dd></div><div><dt>Accent</dt><dd><%= it.sharedDisplay.accent %></dd></div><div><dt>Font</dt><dd><%= it.sharedDisplay.font %></dd></div></dl><a class="button" href="/admin/display/shared">Edit shared defaults</a></section>
    <section class="admin-card" aria-labelledby="local-display-card"><h2 id="local-display-card">This display</h2><p>Browser-only presentation choices with safe inheritance and reset.</p><p class="muted">Local overrides never change other displays.</p><a class="button" href="/admin/display/this-display">Edit this display</a></section>
  </div>
  <section class="admin-card" aria-labelledby="display-advanced"><h2 id="display-advanced">Advanced presentation</h2><p>Tap-card metrics, remaining display, and per-Tap overrides are kept separate from the main visual settings.</p><p><a class="button button--secondary" href="/admin/display/shared#tap-card-settings">Configure Tap-card metrics</a></p></section>
</main>
