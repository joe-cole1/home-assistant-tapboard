<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content">
  <% if (it.fill) { %>
    <div class="page-header"><p class="eyebrow">Keg Room · Filled Keg</p><h1>Filled Keg</h1><p class="muted"><%= it.fill.beverageName %> · Keg <%= it.fill.kegNumber %><% if (it.fill.kegLabel) { %> — <%= it.fill.kegLabel %><% } %></p></div>
    <%~ include("/partials/admin-messages", { page: it.page }) %>
    <div class="page-actions"><a class="secondary" href="<%= it.roomHref %>">Back to Keg Room</a><a class="text-link" href="/admin/keg-room/kegs/<%= it.fill.kegId %>">Physical Keg detail</a></div>
    <section class="admin-card" aria-labelledby="filled-keg-overview"><div class="section-heading"><div><h2 id="filled-keg-overview"><%= it.fill.beverageName %></h2><p class="muted">Read-first lifecycle projection.</p></div><span class="status-badge status-badge--<%= it.fill.state %>"><%= it.fill.stateLabel %></span></div><div class="keg-room-detail-visual"><%~ include("/partials/fill-graphic", { tap: { id: it.fill.id, graphic: it.fill.graphic, title: it.fill.beverageName, accessibleLabel: `${it.fill.beverageName} Filled Keg`, fillPercent: it.fill.fillPercent, displayColor: it.fill.displayColor, tapNumber: it.fill.tapNumber || 0 } }) %></div><dl class="key-value-list"><div><dt>Beverage</dt><dd><%= it.fill.beverageName %></dd></div><div><dt>Physical Keg</dt><dd>Keg <%= it.fill.kegNumber %><% if (it.fill.kegLabel) { %> — <%= it.fill.kegLabel %><% } %></dd></div><div><dt>Tap or queue</dt><dd><% if (it.fill.tapNumber) { %>Tap <%= it.fill.tapNumber %><% } else if (it.fill.queuePosition) { %>Queue position <%= it.fill.queuePosition %><% } else { %>Not queued<% } %></dd></div><div><dt>Remaining estimate</dt><dd><%= it.fill.remainingEstimate %></dd></div><div><dt>Fill date</dt><dd><%= it.fill.fillDate %></dd></div><div><dt>Updated</dt><dd><time datetime="<%= it.fill.updatedAt %>"><%= it.fill.updatedAt %></time></dd></div></dl></section>
    <% if (it.fill.state !== "ended") { %><section class="admin-card" aria-labelledby="assignment"><h2 id="assignment">Tap assignment</h2><% if (it.activeTap) { %><p>Currently assigned to <strong>Tap <%= it.activeTap.tapNumber %></strong><% if (it.activeTap.name) { %> — <%= it.activeTap.name %><% } %>. Assignment lifecycle remains owned by Taps.</p><% } else if (it.availableTaps.length === 0) { %><p class="muted">No available active Taps. Assignment can be started here when a Tap is available.</p><% } else { %><p>Assign this Filled Keg through the existing Tap assignment service.</p><div class="card-actions"><% for (const tap of it.availableTaps) { %><form action="/admin/taps/<%= tap.id %>/assign" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="fillId" value="<%= it.fill.id %>" /><button class="primary" type="submit">Assign to Tap <%= tap.tapNumber %><% if (tap.name) { %> — <%= tap.name %><% } %></button></form><% } %></div><% } %></section><% } %>
    <% if (it.fill.state !== "ended") { %><section class="admin-card" aria-labelledby="filled-keg-lifecycle"><h2 id="filled-keg-lifecycle">Lifecycle</h2><details><summary class="primary">Kick Keg</summary><p>Kick Keg ends the Filled Keg and closes any active Tap assignment. This action only needs an explanatory confirmation.</p><form class="admin-form" action="/admin/fills/<%= it.fill.id %>/kick" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Reason <input name="reason" maxlength="255" /></label><button class="danger" type="submit">Kick Keg</button></form></details></section><% } %>
    <% if (it.fill.state === "ended") { %><section class="admin-card danger-zone" aria-labelledby="delete-filled-keg"><h2 id="delete-filled-keg">Permanent deletion</h2><p>Deletion removes this Fill record.</p><div class="confirmation-copy" data-copy-group><label for="fill-confirmation-value-<%= it.fill.id %>">Exact confirmation value</label><div class="confirmation-copy__row"><input id="fill-confirmation-value-<%= it.fill.id %>" readonly value="<%= it.fill.confirmationLabel %>" /><button class="secondary" type="button" data-copy-target="fill-confirmation-value-<%= it.fill.id %>">Copy</button></div><output data-copy-status aria-live="polite"></output></div><details><summary>Delete Filled Keg permanently</summary><form class="admin-form" action="/admin/fills/<%= it.fill.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Type the exact value above to confirm <input name="confirmation" required autocomplete="off" /></label><label>Reason <input name="reason" maxlength="255" /></label><button class="danger" type="submit">Permanently delete Filled Keg</button></form></details></section><% } %>
  <% } else { %>
    <div class="page-header"><p class="eyebrow">Keg Room · New Fill</p><h1>Fill a Keg</h1><p class="muted">Create a Filled Keg using an active, unoccupied physical Keg.</p></div>
    <%~ include("/partials/admin-messages", { page: it.page }) %>
    <div class="page-actions"><a class="secondary" href="<%= it.roomHref %>">Back to Keg Room</a></div>
    <section class="admin-card" aria-labelledby="new-fill-form"><h2 id="new-fill-form">Fill a Keg</h2><% if (it.beverages.length === 0 || it.kegs.length === 0) { %><p class="muted">Add a Beverage and an available active Physical Keg before creating a Filled Keg.</p><% } else { %><form class="admin-form" action="/admin/fills/create" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Beverage <select name="beverageId" required><option value="">Choose Beverage</option><% for (const beverage of it.beverages) { %><option value="<%= beverage.id %>"><%= beverage.name %></option><% } %></select></label><label>Physical Keg <select name="kegId" required><option value="">Choose Keg</option><% for (const keg of it.kegs) { %><option value="<%= keg.id %>">Keg <%= keg.kegNumber %><% if (keg.label) { %> — <%= keg.label %><% } %></option><% } %></select></label><label>Fill date <input name="fillDate" type="date" /></label><button class="primary" type="submit">Create Filled Keg</button></form><% } %></section>
  <% } %>
</main>
