<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content">
  <nav class="admin-back-link" aria-label="Breadcrumb"><a href="/admin/taps">← Taps</a></nav>
  <header class="page-header tap-detail-header">
    <div>
      <p class="eyebrow">Manage · Tap <%= it.tap.identity.tapNumber %></p>
      <h1>Tap <%= it.tap.identity.tapNumber %><% if (it.tap.identity.name) { %> — <%= it.tap.identity.name %><% } else { %> — (unnamed)<% } %></h1>
      <p class="muted">Read-first operational detail. Public presentation is shown below from the authoritative public projection.</p>
    </div>
    <span class="status-badge status-badge--<%= it.tap.lifecycle.isRetired ? "retired" : it.tap.lifecycle.enabled ? "active" : "disabled" %>"><%= it.tap.lifecycle.isRetired ? "Retired" : it.tap.lifecycle.enabled ? "Enabled" : "Disabled" %></span>
  </header>
  <%~ include("/partials/admin-messages", { page: it.page }) %>

  <section class="admin-card" aria-labelledby="tap-identity-heading">
    <div class="section-heading"><div><h2 id="tap-identity-heading">Identity and lifecycle</h2><p class="muted">Tap number changes affect the telemetry endpoint and require an explicit acknowledgement.</p></div></div>
    <div class="table-scroll">
      <table class="admin-table admin-detail-table">
        <caption class="sr-only">Tap identity and lifecycle</caption>
        <thead><tr><th scope="col">Tap number</th><th scope="col">Name</th><th scope="col">Public display</th><th scope="col">Lifecycle</th><th scope="col">First used</th><th scope="col">Last updated</th></tr></thead>
        <tbody>
          <tr><th scope="row"><%= it.tap.identity.tapNumber %></th><td><%= it.tap.identity.name || "(unnamed)" %></td><td><%= it.tap.lifecycle.enabled ? "Enabled" : "Disabled" %></td><td><%= it.tap.lifecycle.isRetired ? "Retired" : "Active" %></td><td><%= it.tap.lifecycle.firstUsedAtLabel %></td><td><time datetime="<%= it.tap.identity.updatedAt %>"><%= it.tap.identity.updatedAtLabel %></time></td></tr>
        </tbody>
      </table>
    </div>
    <details class="admin-disclosure admin-disclosure--editable">
      <summary><span><strong>Edit tap name</strong><small>Current name: <%= it.tap.identity.name || "(unnamed)" %>.</small></span></summary>
      <form class="admin-form tap-safe-name-form" action="/admin/taps/<%= it.tap.identity.id %>/update" method="post" data-autosave="blur" data-autosave-resource="tap:<%= it.tap.identity.id %>" data-autosave-revision="updatedAt" data-autosave-fields="name">
        <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" />
        <label>Tap name <input name="name" maxlength="120" value="<%= it.tap.identity.name || "" %>" /></label>
        <div class="form-actions"><button class="primary button--small" type="submit">Save name</button><output class="autosave-status" data-autosave-status aria-live="polite"></output></div>
      </form>
    </details>
    <% if (!it.tap.lifecycle.isRetired) { %>
      <details class="admin-disclosure admin-disclosure--editable">
        <summary><span><strong>Edit identity and serving metadata</strong><small>Safe metadata form; concurrency metadata is retained for a later CAS rollout.</small></span></summary>
        <form class="admin-form" action="/admin/taps/<%= it.tap.identity.id %>/update" method="post">
          <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
          <input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" />
          <div class="config-grid">
            <label>Tap number <input name="tapNumber" type="number" min="1" max="1000000" value="<%= it.tap.identity.tapNumber %>" required /></label>
            <label>Public display <select name="enabled"><option value="true"<% if (it.tap.lifecycle.enabled) { %> selected<% } %>>Enabled</option><option value="false"<% if (!it.tap.lifecycle.enabled) { %> selected<% } %>>Disabled</option></select></label>
            <label>Gas type <input name="gasType" maxlength="64" value="<%= it.tap.configuration.gasType || "" %>" /></label>
            <label>Serving pressure (kPa) <input name="servingPressureKpa" type="number" min="0" step="any" value="<%= it.tap.configuration.servingPressureKpa ?? "" %>" /></label>
            <label>Line length (mm) <input name="lineLengthMm" type="number" min="0" step="1" value="<%= it.tap.configuration.lineLengthMm ?? "" %>" /></label>
            <label>Line diameter (mm) <input name="lineDiameterMm" type="number" min="0" step="any" value="<%= it.tap.configuration.lineDiameterMm ?? "" %>" /></label>
          </div>
          <label>Notes <textarea name="notes" maxlength="2048" rows="4"><%= it.tap.configuration.notes || "" %></textarea></label>
          <label class="toggle-control"><input name="acknowledgeTelemetryEndpointImpact" type="checkbox" value="true" /> I understand that changing the number changes <code>/api/v1/telemetry/taps/{tapNumber}</code>.</label>
          <button class="primary button--small" type="submit">Save Tap metadata</button>
        </form>
      </details>
    <% } else { %>
      <p class="muted">Retired Taps preserve their number and history. Identity renumbering is unavailable.</p>
    <% } %>
  </section>

  <section class="admin-card" aria-labelledby="assignment-heading">
    <div class="section-heading"><div><h2 id="assignment-heading">Assignment</h2><p class="muted">Assignment and move operations use the same Tap service as Keg Room.</p></div></div>
    <% if (it.tap.assignment.active) { %>
      <div class="table-scroll">
        <table class="admin-table admin-detail-table">
          <caption class="sr-only">Current Tap assignment</caption>
          <thead><tr><th scope="col">Field</th><th scope="col">Value</th></tr></thead>
          <tbody>
            <tr><th scope="row">Fill</th><td><a href="/admin/keg-room/fills/<%= it.tap.assignment.active.fillId %>"><%= it.tap.assignment.active.beverageName %></a></td></tr>
            <tr><th scope="row">Physical keg</th><td><a href="/admin/keg-room/kegs/<%= it.tap.assignment.active.kegId %>">Keg <%= it.tap.assignment.active.kegNumber %><% if (it.tap.assignment.active.kegLabel) { %> — <%= it.tap.assignment.active.kegLabel %><% } %></a></td></tr>
            <tr><th scope="row">Assigned</th><td><%= it.tap.assignment.active.assignedAtLabel %></td></tr>
          </tbody>
        </table>
      </div>
      <div class="card-actions tap-assignment-actions">
        <form action="/admin/taps/<%= it.tap.identity.id %>/unassign" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><button class="secondary button--small" type="submit">Unassign current Fill</button></form>
        <% if (it.tap.moveTargets.length > 0) { %><form class="inline-form" action="/admin/taps/<%= it.tap.identity.id %>/move" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><label>Move to <select name="targetTapId" required><% for (const target of it.tap.moveTargets) { %><option value="<%= target.id %>">Tap <%= target.tapNumber %><% if (target.name) { %> — <%= target.name %><% } %></option><% } %></select></label><button class="secondary button--small" type="submit">Move Fill</button></form><% } %>
      </div>
    <% } else if (it.tap.lifecycle.isRetired) { %>
      <p class="muted">Retired Taps cannot receive a new Fill assignment.</p>
    <% } else if (it.tap.assignableFills.length === 0) { %>
      <p class="muted">No available Filled Kegs can be assigned right now.</p>
    <% } else { %>
      <form class="admin-form" action="/admin/taps/<%= it.tap.identity.id %>/assign" method="post">
        <input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" />
        <input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" />
        <label>Available Filled Keg <select name="fillId" required><option value="">Choose a Fill</option><% for (const fill of it.tap.assignableFills) { %><option value="<%= fill.id %>"><%= fill.label %></option><% } %></select></label>
        <button class="primary button--small" type="submit">Assign Fill</button>
      </form>
    <% } %>
  </section>

  <section class="admin-card tap-public-preview" aria-labelledby="public-preview-heading">
    <div class="section-heading"><div><h2 id="public-preview-heading">Public preview</h2><p class="muted">Rendered from <code>dashboardService.getTap()</code> and shared display defaults.</p></div></div>
    <% if (it.tap.publicPreview) { %>
      <div class="tap-public-preview__frame"><%~ include("/partials/tap-card", { tap: it.tap.publicPreview, sharedDisplay: it.tap.displayDefaults }) %></div>
    <% } else { %>
      <p class="muted">No public card is available for this disabled, retired, or unassigned Tap.</p>
    <% } %>
  </section>

  <section class="admin-card" aria-labelledby="ops-heading">
    <div class="section-heading"><div><h2 id="ops-heading">Operations and health</h2><p class="muted">Advanced controls remain closed until needed.</p></div></div>
    <details class="admin-disclosure admin-disclosure--editable">
      <summary><span><strong>Telemetry authority</strong><small>Current source: <%= it.tap.telemetry.authorityName %>.</small></span></summary>
      <form class="admin-form" action="/admin/taps/<%= it.tap.identity.id %>/authority" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><label>Authoritative source <select name="sourceId"><option value="">None</option><% for (const source of it.tap.telemetry.sources) { %><option value="<%= source.id %>"<% if (it.tap.telemetry.authoritySourceId === source.id) { %> selected<% } %>><%= source.name %></option><% } %></select></label><button class="button--small" type="submit">Save telemetry authority</button></form>
    </details>
    <details class="admin-disclosure admin-disclosure--editable">
      <summary><span><strong>Pour detector</strong><small>Override only the fields that should differ from global defaults.</small></span></summary>
      <form class="admin-form" action="/admin/taps/<%= it.tap.identity.id %>/detector-config" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><p class="muted">Detection starts with measured volume loss, confirms the Tap during arbitration, records a meaningful pour, and waits for stability before recovery. Leave a field blank to inherit the global default.</p><div class="config-groups"><% for (const group of it.tap.detector.groups) { %><fieldset class="admin-config-group"><legend><%= group.title %></legend><p class="muted"><%= group.description %></p><div class="config-grid"><% for (const field of group.fields) { %><label for="detector-field-<%= field.name %>"><span><%= field.label %></span><input id="detector-field-<%= field.name %>" name="detector.<%= field.name %>" type="number" step="any" value="<%= field.override === null ? "" : field.override %>" placeholder="Inherited: <%= field.effectiveLabel %>" aria-describedby="detector-help-<%= field.name %>" /><small id="detector-help-<%= field.name %>" class="config-field-help"><%= field.help %></small></label><% } %></div></fieldset><% } %></div><button class="button--small" type="submit">Save detector override</button></form>
      <form class="admin-form" action="/admin/taps/<%= it.tap.identity.id %>/rebaseline" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><button class="secondary button--small" type="submit">Manual rebaseline</button></form>
    </details>
    <details class="admin-disclosure admin-disclosure--editable">
      <summary><span><strong>Health rules</strong><small>Effective checks and per-Tap overrides.</small></span></summary>
      <p class="muted">Current aggregate: <strong><%= it.tap.health.overview.stateLabel %></strong><% if (it.tap.health.overview.severity !== "none") { %> · <%= it.tap.health.overview.severityLabel %><% } %>.</p>
      <% if (it.tap.health.overview.checks.length > 0) { %><ul class="compact-list"><% for (const check of it.tap.health.overview.checks) { %><li><strong><%= check.label %></strong>: <%= check.stateLabel %><% if (check.severity !== "none") { %> · <%= check.severityLabel %><% } %><% if (check.reasonLabel) { %> — <%= check.reasonLabel %><% } %></li><% } %></ul><% } %>
      <form class="admin-form" action="/admin/taps/<%= it.tap.identity.id %>/health-config" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><p class="muted">Each check below explains what it watches. Leave a field blank to inherit the global default; submitted field names and values remain canonical.</p><div class="config-groups"><% for (const section of it.tap.health.sections) { %><fieldset class="admin-config-group"><legend><%= section.title %></legend><p class="muted"><%= section.description %></p><div class="config-grid"><% for (const field of section.fields) { %><% if (typeof field.effective === "boolean") { %><label for="health-field-<%= section.id %>-<%= field.name %>"><span><%= field.label %></span><select id="health-field-<%= section.id %>-<%= field.name %>" name="health.<%= section.id %>.<%= field.name %>" aria-describedby="health-help-<%= section.id %>-<%= field.name %>"><option value="">Inherit (<%= field.effective ? "enabled" : "disabled" %>)</option><option value="true"<% if (field.override === true) { %> selected<% } %>>Enabled</option><option value="false"<% if (field.override === false) { %> selected<% } %>>Disabled</option></select><small id="health-help-<%= section.id %>-<%= field.name %>" class="config-field-help"><%= field.help %></small></label><% } else { %><label for="health-field-<%= section.id %>-<%= field.name %>"><span><%= field.label %></span><input id="health-field-<%= section.id %>-<%= field.name %>" name="health.<%= section.id %>.<%= field.name %>" type="number" step="any" value="<%= field.override === null ? "" : field.override %>" placeholder="Inherited: <%= field.effectiveLabel %>" aria-describedby="health-help-<%= section.id %>-<%= field.name %>" /><small id="health-help-<%= section.id %>-<%= field.name %>" class="config-field-help"><%= field.help %></small></label><% } %><% } %></div></fieldset><% } %></div><button class="button--small" type="submit">Save health override</button></form>
    </details>
    <details class="admin-disclosure admin-disclosure--editable">
      <summary><span><strong>Public display override</strong><small>Metric visibility only; Remaining mode follows Display.</small></span></summary>
      <% if (it.tap.display.tapCard) { %><form class="admin-form" action="/admin/taps/<%= it.tap.identity.id %>/display" method="post" data-autosave="blur" data-autosave-resource="tap:<%= it.tap.identity.id %>" data-autosave-revision="updatedAt" data-autosave-fields="showAbv,showIbu,showOg,showFg,showSrm"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><div class="tap-card-override-grid"><% for (const metric of [["showAbv", "ABV"], ["showIbu", "IBU"], ["showOg", "OG"], ["showFg", "FG"], ["showSrm", "SRM"]]) { const override = it.tap.display.tapCard.override?.[metric[0]] ?? null; const effective = it.tap.display.tapCard.effective[metric[0]]; %><fieldset><legend><%= metric[1] %></legend><label>Display <select name="<%= metric[0] %>"><option value="inherit"<% if (override === null) { %> selected<% } %>>Inherit (<%= effective ? "show" : "hide" %>)</option><option value="show"<% if (override === true) { %> selected<% } %>>Show</option><option value="hide"<% if (override === false) { %> selected<% } %>>Hide</option></select></label></fieldset><% } %></div><div class="form-actions"><button class="button--small" type="submit">Save display override</button><output class="autosave-status" data-autosave-status aria-live="polite"></output></div></form><% } else { %><p class="muted">Per-Tap display settings are unavailable.</p><% } %>
    </details>
    <details class="admin-disclosure admin-disclosure--editable">
      <summary><span><strong>Line maintenance</strong><small>Append-only maintenance records and due-state support.</small></span></summary>
      <% if (it.tap.maintenance.records.length > 0) { %><ul class="compact-list"><% for (const record of it.tap.maintenance.records) { %><li><strong><%= record.maintenanceType %></strong> · <%= record.performedAtMs %></li><% } %></ul><% } else { %><p class="muted">No maintenance records are available.</p><% } %>
      <form class="admin-form" action="/admin/taps/<%= it.tap.identity.id %>/maintenance" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><label>Maintenance type <select name="maintenanceType"><option value="line_cleaned">Line cleaned</option><option value="sanitized">Sanitized</option><option value="inspection">Inspection</option><option value="repair">Repair</option><option value="other">Other</option></select></label><label>Notes <textarea name="notes" maxlength="255"></textarea></label><button class="button--small" type="submit">Record maintenance</button></form>
    </details>
    <details class="admin-disclosure admin-disclosure--editable">
      <summary><span><strong>Mystery Tap reveal fields</strong><small>Assignment-scoped allowlist; identity remains protected.</small></span></summary>
      <% if (!it.tap.assignment.active || !it.tap.assignment.mystery) { %><p class="muted">Mystery settings are unavailable until this Tap has an active Fill assignment.</p><% } else { %><p>Mystery is <strong><%= it.tap.assignment.mystery.enabled ? "enabled" : "disabled" %></strong>. Tap and Beverage identity remain protected when enabled.</p><form class="admin-form" action="/admin/taps/<%= it.tap.identity.id %>/mystery" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><label class="toggle-control"><input type="checkbox" name="enabled" value="true"<% if (it.tap.assignment.mystery.enabled) { %> checked<% } %> /> Enable Mystery Tap</label><fieldset><legend>Reveal allowlist</legend><div class="toggle-grid"><% for (const field of [["revealBeverageType", "Beverage type"], ["revealStyle", "Style"], ["revealAbv", "ABV"], ["revealIbu", "IBU"], ["revealOg", "OG"], ["revealFg", "FG"], ["revealSrm", "SRM"], ["revealDescription", "Description"], ["revealRecipe", "Recipe"], ["revealSensory", "Sensory profile"], ["revealHistory", "Fill history"]]) { %><label class="toggle-control"><input type="checkbox" name="<%= field[0] %>" value="true"<% if (it.tap.assignment.mystery[field[0]]) { %> checked<% } %> /> <%= field[1] %></label><% } %></div></fieldset><button class="button--small" type="submit">Save Mystery settings</button></form><% } %>
    </details>
  </section>

  <% if (!it.tap.lifecycle.isRetired) { %>
    <section class="admin-card" aria-labelledby="lifecycle-heading">
      <div class="section-heading"><div><h2 id="lifecycle-heading">Lifecycle</h2><p class="muted">Retirement is reversible only through a future explicit workflow; no typed confirmation is required.</p></div></div>
      <% if (it.tap.assignment.active) { %><p class="muted">Unassign the current Fill before retiring this Tap.</p><% } else { %><details class="admin-disclosure"><summary>Retire Tap</summary><form class="admin-form" action="/admin/taps/<%= it.tap.identity.id %>/retire" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><label>Reason <input name="reason" maxlength="255" /></label><button class="danger button--small" type="submit">Retire Tap</button></form></details><% } %>
    </section>
  <% } %>

  <section class="admin-card danger-zone" aria-labelledby="tap-delete-heading">
    <div class="section-heading"><div><h2 id="tap-delete-heading">Permanent deletion</h2><p class="muted">Only a never-used, non-retired, unassigned Tap can be deleted. Deletion removes the Tap record and its deletion audit entry.</p></div></div>
    <% if (it.tap.deletionImpact) { %>
      <% if (it.tap.deletionImpact.canDelete) { %>
        <div class="confirmation-copy" data-copy-group><label for="tap-confirmation-value-<%= it.tap.identity.id %>">Exact confirmation value</label><div class="confirmation-copy__row"><input id="tap-confirmation-value-<%= it.tap.identity.id %>" readonly value="<%= it.tap.identity.confirmationLabel %>" /><button class="secondary button--small" type="button" data-copy-target="tap-confirmation-value-<%= it.tap.identity.id %>">Copy</button></div><output data-copy-status aria-live="polite"></output></div><form class="admin-form" action="/admin/taps/<%= it.tap.identity.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.tap.identity.updatedAt %>" /><label>Type the exact value above to confirm <input name="confirmation" autocomplete="off" required /></label><label>Reason <input name="reason" maxlength="255" /></label><button class="danger button--small" type="submit">Permanently delete Tap</button></form>
      <% } else { %>
        <p class="muted">Deletion is unavailable because this Tap has history or active dependencies.</p>
        <ul class="impact-list"><% for (const reason of it.tap.deletionImpact.reasonsCannotDelete) { %><li><%= reason %></li><% } %></ul>
      <% } %>
    <% } else { %><p class="muted">Deletion impact is unavailable.</p><% } %>
  </section>
</main>
