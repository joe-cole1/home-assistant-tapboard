<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content">
  <h1>Overview</h1>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <section aria-labelledby="summary-heading">
    <h2 id="summary-heading">Operational summary</h2>
    <dl class="metrics"><% for (const item of it.metrics) { %><div><dt><%= item.label %></dt><dd><%= item.value %></dd></div><% } %></dl>
  </section>
  <section aria-labelledby="connectivity-heading">
    <h2 id="connectivity-heading">Connectivity and integrations</h2>
    <p><strong><%= it.connectivity.state === "healthy" ? "Healthy" : "Needs attention" %></strong> — <%= it.connectivity.label %></p>
    <dl class="metrics"><div><dt>Telemetry</dt><dd><%= it.integrations.telemetryConfigured %> configured</dd></div><div><dt>Brewfather</dt><dd><%= it.integrations.brewfatherConfigured ? (it.integrations.brewfatherEnabled ? (it.integrations.brewfatherApiKeyConfigured ? "Enabled" : "API key required") : "Disabled") : "Not configured" %></dd></div><div><dt>Linked Beverages</dt><dd><%= it.integrations.brewfatherLinkedBeverages %></dd></div></dl>
  </section>
  <section aria-labelledby="health-summary-heading">
    <h2 id="health-summary-heading">Health summary</h2>
    <% const attention = it.health.filter((item) => item.state === "degraded" || item.severity === "warning" || item.severity === "critical"); %>
    <% if (attention.length === 0) { %><p>No Tap health warnings are currently reported.</p><% } else { %><ul><% for (const item of attention) { %><li>Tap <%= item.tapNumber ?? "unknown" %>: <%= item.severity %> (<%= item.state %>)</li><% } %></ul><% } %>
  </section>
  <section aria-labelledby="tap-summary-heading">
    <h2 id="tap-summary-heading">Taps and current assignments</h2>
    <% if (it.taps.length === 0) { %><p>No Taps are configured.</p><% } else { %>
      <table><thead><tr><th scope="col">Tap</th><th scope="col">Name</th><th scope="col">Assignment</th><th scope="col">Public</th></tr></thead><tbody>
      <% for (const tap of it.taps) { %><tr><th scope="row">#<%= tap.tapNumber %></th><td><%= tap.name || "—" %></td><td><%= tap.beverageName || "Unassigned" %></td><td><%= tap.enabled ? "Enabled" : "Disabled" %></td></tr><% } %>
      </tbody></table>
    <% } %>
  </section>
</main>
