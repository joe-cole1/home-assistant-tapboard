<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content">
  <div class="page-header"><p class="eyebrow">Keg Room · Inventory</p><h1>Keg <%= it.keg.kegNumber %></h1><p class="muted"><%= it.keg.label || "Physical Keg" %> · <%= it.keg.isActive ? "Active" : "Inactive" %></p></div>
  <%~ include("/partials/admin-messages", { page: it.page }) %>
  <div class="page-actions"><a class="secondary" href="<%= it.inventoryHref %>">Back to Physical Kegs</a><a class="text-link" href="<%= it.roomHref %>">Keg Room</a></div>
  <section class="admin-card" aria-labelledby="keg-overview"><div class="section-heading"><div><h2 id="keg-overview">Read-first overview</h2><p class="muted">Current identity is used for future compare-and-save operations.</p></div><span class="status-badge"><%= it.keg.isActive ? "Active" : "Inactive" %></span></div><dl class="key-value-list"><div><dt>Visible identity</dt><dd>Keg <%= it.keg.kegNumber %><% if (it.keg.label) { %> — <%= it.keg.label %><% } %></dd></div><div><dt>Capacity</dt><dd><%= it.keg.capacityMl %> mL</dd></div><div><dt>Current tare</dt><dd><%= it.keg.currentTareG %> g</dd></div><div><dt>Updated</dt><dd><time datetime="<%= it.keg.updatedAt %>"><%= it.keg.updatedAt %></time></dd></div></dl></section>
  <section class="admin-card" aria-labelledby="keg-label-heading"><div class="section-heading"><div><h2 id="keg-label-heading">Keg label</h2><p class="muted">Human-facing inventory metadata.</p></div></div><p><strong>Current label:</strong> <%= it.keg.label || "No label" %></p><details class="admin-disclosure admin-disclosure--editable"><summary><span><strong>Edit label</strong><small>Changes save safely when you leave the field.</small></span></summary><form class="admin-form" action="/admin/kegs/<%= it.keg.id %>/update" method="post" data-autosave="blur" data-autosave-resource="keg:<%= it.keg.id %>" data-autosave-revision="updatedAt" data-autosave-fields="label"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><input type="hidden" name="updatedAt" value="<%= it.keg.updatedAt %>" /><label>Label <input name="label" maxlength="120" value="<%= it.keg.label || "" %>" /></label><div class="form-actions"><button class="primary" type="submit">Save label</button><output class="autosave-status" data-autosave-status aria-live="polite"></output></div></form></details></section>
  <section class="admin-card" aria-labelledby="keg-fill-history"><h2 id="keg-fill-history">Fill history</h2><% if (it.keg.fillHistory.length === 0) { %><p class="muted">No Filled Kegs recorded.</p><% } else { %><table><thead><tr><th scope="col">Beverage</th><th scope="col">Fill date</th><th scope="col">State</th><th scope="col">Ended</th></tr></thead><tbody><% for (const fill of it.keg.fillHistory) { %><tr><th scope="row"><a href="/admin/keg-room/fills/<%= fill.id %>"><%= fill.beverageName %></a></th><td><%= fill.fillDate %></td><td><%= fill.state %></td><td><%= fill.endedAt || "—" %></td></tr><% } %></tbody></table><% } %></section>
  <section class="admin-card" aria-labelledby="keg-history"><h2 id="keg-history">Audit and maintenance history</h2><p><%= it.keg.tareHistory.length %> tare correction(s); <%= it.keg.maintenanceHistory.length %> maintenance record(s).</p><details><summary>Show tare corrections</summary><% if (it.keg.tareHistory.length === 0) { %><p class="muted">No tare corrections recorded.</p><% } else { %><ul><% for (const item of it.keg.tareHistory) { %><li><%= item.previousTareG === null ? "Initial" : `${item.previousTareG} g` %> → <%= item.newTareG %> g · <time datetime="<%= item.recordedAt %>"><%= item.recordedAt %></time><% if (item.reason) { %> · <%= item.reason %><% } %></li><% } %></ul><% } %></details><details><summary>Show maintenance records</summary><% if (it.keg.maintenanceHistory.length === 0) { %><p class="muted">No maintenance records recorded.</p><% } else { %><ul><% for (const item of it.keg.maintenanceHistory) { %><li><%= item.maintenanceType %> · <time datetime="<%= item.recordedAt %>"><%= item.recordedAt %></time></li><% } %></ul><% } %></details></section>
  <section class="admin-card" aria-labelledby="keg-advanced"><h2 id="keg-advanced">Advanced physical controls</h2><p class="muted">Editing hardware/tare values is intentionally collapsed and remains on the existing domain action paths.</p><details><summary>Edit Keg</summary><form class="admin-form" action="/admin/kegs/<%= it.keg.id %>/update" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Number <input name="kegNumber" type="number" min="1" value="<%= it.keg.kegNumber %>" required /></label><label>Capacity (mL) <input name="capacityMl" type="number" min="1" value="<%= it.keg.capacityMl %>" required /></label><label>Tare (g) <input name="currentTareG" type="number" min="0" step="1" value="<%= it.keg.currentTareG %>" required /></label><label>Status <select name="isActive"><option value="true"<% if (it.keg.isActive) { %> selected<% } %>>Active</option><option value="false"<% if (!it.keg.isActive) { %> selected<% } %>>Inactive</option></select></label><label>Correction reason <input name="reason" maxlength="255" /></label><button class="secondary" type="submit">Save Keg</button></form></details><details><summary>Record maintenance</summary><form class="admin-form" action="/admin/kegs/<%= it.keg.id %>/maintenance" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Type <input name="maintenanceType" maxlength="80" required /></label><label>Notes <textarea name="notes" maxlength="2048"></textarea></label><button class="secondary" type="submit">Record maintenance</button></form></details></section>
  <section class="admin-card danger-zone" aria-labelledby="delete-keg"><h2 id="delete-keg">Permanent deletion</h2><p>Deletion removes this Keg and its tare/maintenance records.</p><div class="confirmation-copy" data-copy-group><label for="keg-confirmation-value-<%= it.keg.id %>">Exact confirmation value</label><div class="confirmation-copy__row"><input id="keg-confirmation-value-<%= it.keg.id %>" readonly value="<%= it.keg.confirmationLabel %>" /><button class="secondary" type="button" data-copy-target="keg-confirmation-value-<%= it.keg.id %>">Copy</button></div><output data-copy-status aria-live="polite"></output></div><details><summary>Delete Keg permanently</summary><form class="admin-form" action="/admin/kegs/<%= it.keg.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Type the exact value above to confirm <input name="confirmation" required autocomplete="off" /></label><label>Reason <input name="reason" maxlength="255" /></label><p class="muted"><% for (const impact of it.keg.deletionImpacts) { %><%= impact.code %>: <%= impact.count %> · <% } %></p><button class="danger" type="submit">Permanently delete Keg</button></form></details></section>
</main>
