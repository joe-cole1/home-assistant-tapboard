<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content"><h1>Taps</h1><%~ include("/partials/admin-messages", { page: it.page }) %>
  <section aria-labelledby="tap-list"><h2 id="tap-list">Tap configuration</h2><% if (it.taps.length === 0) { %><p>No Taps are configured.</p><% } else { %><div class="resource-list"><% for (const tap of it.taps) { %><article class="resource-card"><h3>Tap <%= tap.tapNumber %><% if (tap.name) { %> — <%= tap.name %><% } %></h3><p><%= tap.enabled ? "Publicly enabled" : "Publicly disabled" %> · <%= tap.isRetired ? "Retired" : "Active" %> · <%= tap.beverageName || "Unassigned" %></p><p>Telemetry: <%= tap.authority %> · Health: <%= tap.health %></p><dl><dt>Gas type</dt><dd><%= tap.gasType || "—" %></dd><dt>Serving pressure (kPa)</dt><dd><%= tap.servingPressureKpa === null ? "—" : tap.servingPressureKpa %></dd><dt>Line length (mm)</dt><dd><%= tap.lineLengthMm === null ? "—" : tap.lineLengthMm %></dd><dt>Line diameter (mm)</dt><dd><%= tap.lineDiameterMm === null ? "—" : tap.lineDiameterMm %></dd><dt>Notes</dt><dd><%= tap.notes || "—" %></dd></dl>
      <% if (!tap.isRetired) { %><details><summary>Edit</summary><form action="/admin/taps/<%= tap.id %>/update" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Number <input name="tapNumber" type="number" min="1" value="<%= tap.tapNumber %>" required /></label><label>Name <input name="name" value="<%= tap.name || "" %>" /></label><label>Public display <select name="enabled"><option value="true"<% if (tap.enabled) { %> selected<% } %>>Enabled</option><option value="false"<% if (!tap.enabled) { %> selected<% } %>>Disabled</option></select></label><label>Gas type <input name="gasType" value="<%= tap.gasType || "" %>" /></label><label>Serving pressure (kPa) <input name="servingPressureKpa" type="number" step="any" value="<%= tap.servingPressureKpa === null ? "" : tap.servingPressureKpa %>" /></label><label>Line length (mm) <input name="lineLengthMm" type="number" step="any" value="<%= tap.lineLengthMm === null ? "" : tap.lineLengthMm %>" /></label><label>Line diameter (mm) <input name="lineDiameterMm" type="number" step="any" value="<%= tap.lineDiameterMm === null ? "" : tap.lineDiameterMm %>" /></label><label>Notes <textarea name="notes"><%= tap.notes || "" %></textarea></label><label><input name="acknowledgeTelemetryEndpointImpact" type="checkbox" value="true" /> I understand renumbering changes the telemetry endpoint</label><button type="submit">Update Tap</button></form></details>
      <% if (tap.beverageName) { %><form action="/admin/taps/<%= tap.id %>/unassign" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button type="submit">Unassign current Fill</button></form><% if (tap.moveTargets.length > 0) { %><form action="/admin/taps/<%= tap.id %>/move" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Move current Fill to <select name="targetTapId" required><% for (const target of tap.moveTargets) { %><option value="<%= target.id %>">Tap <%= target.tapNumber %></option><% } %></select></label><button type="submit">Move Fill</button></form><% } %><% } else { %><form action="/admin/taps/<%= tap.id %>/assign" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Assign available Fill <select name="fillId" required><option value="">Choose Fill</option><% for (const fill of it.fills) { %><option value="<%= fill.id %>"><%= fill.label %></option><% } %></select></label><button type="submit">Assign Fill</button></form><% } %>
      <details><summary>Telemetry authority</summary><form action="/admin/taps/<%= tap.id %>/authority" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Authoritative source <select name="sourceId"><option value="">None</option><% for (const source of it.telemetrySources) { %><option value="<%= source.id %>"<% if (tap.authoritySourceId === source.id) { %> selected<% } %>><%= source.name %></option><% } %></select></label><button type="submit">Set authority</button></form></details>
      <details><summary>Pour-detector override</summary><p>Leave a value empty to inherit the global detector configuration.</p><form action="/admin/taps/<%= tap.id %>/detector-config" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><div class="config-grid"><% for (const field of tap.detectorFields) { %><label><%= field.name %> <input name="detector.<%= field.name %>" type="number" step="any" value="<%= field.override === null ? "" : field.override %>" placeholder="Inherited: <%= field.effective %>" /></label><% } %></div><button type="submit">Save detector override</button></form></details>
      <details><summary>Health override</summary><p>Leave a field on “Inherit” to follow the shared health configuration.</p><form action="/admin/taps/<%= tap.id %>/health-config" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><% for (const section of tap.healthSections) { %><fieldset><legend><%= section.id %></legend><div class="config-grid"><% for (const field of section.fields) { %><% if (typeof field.effective === "boolean") { %><label><%= field.name %> <select name="health.<%= section.id %>.<%= field.name %>"><option value="">Inherit (<%= field.effective ? "enabled" : "disabled" %>)</option><option value="true"<% if (field.override === true) { %> selected<% } %>>Enabled</option><option value="false"<% if (field.override === false) { %> selected<% } %>>Disabled</option></select></label><% } else { %><label><%= field.name %> <input name="health.<%= section.id %>.<%= field.name %>" type="number" step="any" value="<%= field.override === null ? "" : field.override %>" placeholder="Inherited: <%= field.effective %>" /></label><% } %><% } %></div></fieldset><% } %><button type="submit">Save health override</button></form></details>
      <form action="/admin/taps/<%= tap.id %>/rebaseline" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><button type="submit">Manual rebaseline</button></form><details><summary>Line maintenance</summary><form action="/admin/taps/<%= tap.id %>/maintenance" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Type <select name="maintenanceType"><option value="line_cleaned">Line cleaned</option><option value="sanitized">Sanitized</option><option value="inspection">Inspection</option><option value="repair">Repair</option><option value="other">Other</option></select></label><label>Notes <textarea name="notes"></textarea></label><button type="submit">Record maintenance</button></form></details><details><summary>Retire Tap</summary><form action="/admin/taps/<%= tap.id %>/retire" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Reason <input name="reason" /></label><button class="danger" type="submit">Retire unassigned Tap</button></form></details><% } %>
      <details><summary>Mystery Tap visibility</summary><% if (!tap.mystery) { %><p>Mystery settings are unavailable until this Tap has an active Fill assignment.</p><% } else { %><p>Mystery is <strong><%= tap.mystery.enabled ? "enabled" : "disabled" %></strong>. Hidden fields remain unavailable until explicitly revealed.</p><form action="/admin/taps/<%= tap.id %>/mystery" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label><input type="checkbox" name="enabled" value="true"<% if (tap.mystery.enabled) { %> checked<% } %> /> Enable Mystery Tap</label><fieldset><legend>Reveal allowlist</legend><label><input type="checkbox" name="revealBeverageType" value="true"<% if (tap.mystery.revealBeverageType) { %> checked<% } %> /> Beverage type</label><label><input type="checkbox" name="revealStyle" value="true"<% if (tap.mystery.revealStyle) { %> checked<% } %> /> Style</label><label><input type="checkbox" name="revealAbv" value="true"<% if (tap.mystery.revealAbv) { %> checked<% } %> /> ABV</label><label><input type="checkbox" name="revealIbu" value="true"<% if (tap.mystery.revealIbu) { %> checked<% } %> /> IBU</label><label><input type="checkbox" name="revealOg" value="true"<% if (tap.mystery.revealOg) { %> checked<% } %> /> OG</label><label><input type="checkbox" name="revealFg" value="true"<% if (tap.mystery.revealFg) { %> checked<% } %> /> FG</label><label><input type="checkbox" name="revealSrm" value="true"<% if (tap.mystery.revealSrm) { %> checked<% } %> /> SRM</label><label><input type="checkbox" name="revealDescription" value="true"<% if (tap.mystery.revealDescription) { %> checked<% } %> /> Description</label><label><input type="checkbox" name="revealRecipe" value="true"<% if (tap.mystery.revealRecipe) { %> checked<% } %> /> Recipe</label><label><input type="checkbox" name="revealSensory" value="true"<% if (tap.mystery.revealSensory) { %> checked<% } %> /> Sensory profile</label><label><input type="checkbox" name="revealHistory" value="true"<% if (tap.mystery.revealHistory) { %> checked<% } %> /> Fill history</label></fieldset><p>Beverage name and custom Tap name are always hidden; physical Tap number remains visible.</p><button type="submit">Save Mystery settings</button></form><% } %></details></article><% } %></div><% } %></section>
  <section aria-labelledby="create-tap"><h2 id="create-tap">Add Tap</h2><form action="/admin/taps/create" method="post"><input type="hidden" name="_csrf" value="<%= it.page.csrfToken %>" /><label>Number <input name="tapNumber" type="number" min="1" required /></label><label>Name <input name="name" /></label><label>Gas type <input name="gasType" /></label><label>Serving pressure (kPa) <input name="servingPressureKpa" type="number" step="any" /></label><label>Line length (mm) <input name="lineLengthMm" type="number" step="any" /></label><label>Line diameter (mm) <input name="lineDiameterMm" type="number" step="any" /></label><label>Notes <textarea name="notes"></textarea></label><input type="hidden" name="enabled" value="true" /><button type="submit">Create Tap</button></form></section>
</main>
