<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content">
  <header class="page-header">
    <p class="eyebrow">Manage</p>
    <h1>Taps</h1>
    <p class="muted">A compact view of serving positions, assignments, and current health.</p>
  </header>
  <%~ include("/partials/admin-messages", { page: it.page }) %>

  <section class="section-heading" aria-labelledby="tap-list-heading">
    <div>
      <h2 id="tap-list-heading">Tap list</h2>
      <p class="muted"><%= it.pagination.total %> tap<%= it.pagination.total === 1 ? "" : "s" %></p>
    </div>
    <a class="button primary button--small" href="/admin/taps/new">Add Tap</a>
  </section>

  <form class="admin-search" method="get" action="/admin/taps" role="search">
    <label for="tap-search">Search by tap number, name, assignment, or keg</label>
    <div class="admin-search__controls">
      <input id="tap-search" name="q" type="search" value="<%= it.query %>" maxlength="80" />
      <label class="sr-only" for="tap-state">Tap state</label>
      <select id="tap-state" name="state">
        <% for (const state of ["all", "assigned", "unassigned", "disabled", "retired"]) { %>
          <option value="<%= state %>"<% if (it.state === state) { %> selected<% } %>><%= state[0].toUpperCase() + state.slice(1) %></option>
        <% } %>
      </select>
      <button class="button--small" type="submit">Filter</button>
      <% if (it.query || it.state !== "all") { %><a class="button secondary button--small" href="/admin/taps">Clear</a><% } %>
    </div>
  </form>

  <% if (it.taps.length === 0) { %>
    <section class="empty-state admin-card" aria-labelledby="tap-empty-heading">
      <h2 id="tap-empty-heading"><%= it.query || it.state !== "all" ? "No matching Taps" : "No Taps are configured" %></h2>
      <p><%= it.query || it.state !== "all" ? "Try a different search or state filter." : "Create a Tap to establish a serving position." %></p>
      <a class="button primary button--small" href="/admin/taps/new"><%= it.query || it.state !== "all" ? "Add a Tap" : "Create the first Tap" %></a>
    </section>
  <% } else { %>
    <div class="table-scroll">
      <table class="admin-table tap-list" aria-label="Taps">
        <caption class="sr-only">Tap assignments and health</caption>
        <thead><tr><th scope="col">Tap</th><th scope="col">Assignment</th><th scope="col">Remaining</th><th scope="col">Health</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
        <tbody>
          <% for (const tap of it.taps) { %>
            <tr data-tap-id="<%= tap.id %>">
              <th scope="row"><a href="/admin/taps/<%= tap.id %>">Tap <%= tap.tapNumber %><% if (tap.name) { %> — <%= tap.name %><% } else { %> — Unnamed Tap<% } %></a></th>
              <td><% if (tap.assignment) { %><a href="/admin/keg-room/fills/<%= tap.assignment.fillId %>"><%= tap.assignmentLabel %></a><% if (tap.assignment.kegId) { %><span class="muted"> · <a href="/admin/keg-room/kegs/<%= tap.assignment.kegId %>">Keg <%= tap.assignment.kegNumber %><% if (tap.assignment.kegLabel) { %> — <%= tap.assignment.kegLabel %><% } %></a></span><% } %><% } else { %>Unassigned<% } %></td>
              <td><%= tap.remaining %></td>
              <td><span class="status-badge status-badge--<%= tap.health.severity === "critical" ? "critical" : tap.health.severity === "warning" || tap.health.state === "degraded" ? "warning" : tap.health.state === "healthy" ? "healthy" : "muted" %>"><%= tap.healthLabel %><% if (tap.health.severity !== "none") { %> · <%= tap.health.severityLabel %><% } %></span></td>
              <td><span class="status-badge status-badge--<%= tap.isRetired ? "retired" : tap.enabled ? "active" : "disabled" %>"><%= tap.statusLabel %></span></td>
              <td><a class="button secondary button--small" href="/admin/taps/<%= tap.id %>">Open</a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if (it.pagination.pageCount > 1) { %>
      <nav class="pagination" aria-label="Tap pages">
        <% if (it.pagination.previousHref) { %><a class="button secondary button--small" href="<%= it.pagination.previousHref %>">Previous</a><% } %>
        <span>Page <%= it.pagination.page %> of <%= it.pagination.pageCount %></span>
        <% if (it.pagination.nextHref) { %><a class="button secondary button--small" href="<%= it.pagination.nextHref %>">Next</a><% } %>
      </nav>
    <% } %>
  <% } %>
</main>
