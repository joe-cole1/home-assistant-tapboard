<% layout("/layouts/admin", { page: it.page }) %>
<%~ include("/partials/admin-nav", { page: it.page, items: it.navItems || [] }) %>
<main id="main-content">
  <header class="page-header">
    <p class="eyebrow">Manage</p>
    <h1>Taps</h1>
    <p class="muted">A compact view of serving positions, assignments, and current health.</p>
  </header>
  <%~ include("/partials/admin-messages", { page: it.page }) %>

  <section class="section-heading" aria-labelledby="tap-list-heading">
    <div>
      <h2 id="tap-list-heading">Tap list</h2>
      <p class="muted"><%= it.pagination.total %> tap<%= it.pagination.total === 1 ? "" : "s" %></p>
    </div>
    <a class="button primary" href="/admin/taps/new">Add Tap</a>
  </section>

  <form class="admin-search" method="get" action="/admin/taps" role="search">
    <label for="tap-search">Search by tap number, name, assignment, or keg</label>
    <div class="admin-search__controls">
      <input id="tap-search" name="q" type="search" value="<%= it.query %>" maxlength="80" />
      <label class="sr-only" for="tap-state">Tap state</label>
      <select id="tap-state" name="state">
        <% for (const state of ["all", "assigned", "unassigned", "disabled", "retired"]) { %>
          <option value="<%= state %>"<% if (it.state === state) { %> selected<% } %>><%= state[0].toUpperCase() + state.slice(1) %></option>
        <% } %>
      </select>
      <button type="submit">Filter</button>
      <% if (it.query || it.state !== "all") { %><a class="button secondary" href="/admin/taps">Clear</a><% } %>
    </div>
  </form>

  <% if (it.taps.length === 0) { %>
    <section class="empty-state admin-card" aria-labelledby="tap-empty-heading">
      <h2 id="tap-empty-heading"><%= it.query || it.state !== "all" ? "No matching Taps" : "No Taps are configured" %></h2>
      <p><%= it.query || it.state !== "all" ? "Try a different search or state filter." : "Create a Tap to establish a serving position." %></p>
      <a class="button primary" href="/admin/taps/new"><%= it.query || it.state !== "all" ? "Add a Tap" : "Create the first Tap" %></a>
    </section>
  <% } else { %>
    <div class="resource-list tap-list" aria-label="Taps">
      <% for (const tap of it.taps) { %>
        <article class="resource-card tap-list-card" data-tap-id="<%= tap.id %>">
          <div class="tap-list-card__header">
            <div>
              <p class="eyebrow">Tap <%= tap.tapNumber %></p>
              <h2><a href="/admin/taps/<%= tap.id %>"><% if (tap.name) { %><%= tap.name %><% } else { %>Unnamed Tap<% } %></a></h2>
            </div>
            <span class="status-badge status-badge--<%= tap.isRetired ? "retired" : tap.enabled ? "active" : "disabled" %>"><%= tap.isRetired ? "Retired" : tap.enabled ? "Enabled" : "Disabled" %></span>
          </div>
          <dl class="tap-list-card__summary">
            <div><dt>Assignment</dt><dd><%= tap.assignmentLabel %><% if (tap.kegLabel) { %><span class="muted"> · <%= tap.kegLabel %></span><% } %></dd></div>
            <div><dt>Remaining</dt><dd><%= tap.remaining %></dd></div>
            <div><dt>Health</dt><dd><%= tap.health.state %><% if (tap.health.severity !== "none") { %> · <%= tap.health.severity %><% } %></dd></div>
          </dl>
          <div class="card-actions">
            <a class="button secondary" href="/admin/taps/<%= tap.id %>">Open Tap detail</a>
          </div>
        </article>
      <% } %>
    </div>
    <% if (it.pagination.pageCount > 1) { %>
      <nav class="pagination" aria-label="Tap pages">
        <% if (it.pagination.previousHref) { %><a class="button secondary" href="<%= it.pagination.previousHref %>">Previous</a><% } %>
        <span>Page <%= it.pagination.page %> of <%= it.pagination.pageCount %></span>
        <% if (it.pagination.nextHref) { %><a class="button secondary" href="<%= it.pagination.nextHref %>">Next</a><% } %>
      </nav>
    <% } %>
  <% } %>
</main>
