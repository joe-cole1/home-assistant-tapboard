<% layout("/layouts/public", { sharedDisplay: it.sharedDisplay, header: it.header }) %>
<%~ include("/partials/public-header", { header: it.header }) %>
<main id="main-content" class="story-page">
  <% if (!it.story) { %>
    <p><a class="story-back" href="/">← Back</a></p>
    <section aria-labelledby="story-not-found"><h1 id="story-not-found">Story unavailable</h1><p>This tap story is not available.</p></section>
  <% } else { const story = it.story; const presentation = story.presentation; const current = story.currentFill; %>
    <a class="story-back" href="/">← Back</a>
    <header class="story-header">
      <h1>Tap <%= story.tapNumber %> · <%= story.title %></h1>
    </header>
    <section class="story-overview" aria-labelledby="story-overview">
      <div>
        <h2 id="story-overview">Overview</h2>
        <dl>
          <% if (presentation.beverageName) { %><dt>Name</dt><dd><%= presentation.beverageName %></dd><% } %>
          <% if (presentation.beverageType) { %><dt>Type</dt><dd><%= presentation.beverageType %></dd><% } %>
          <% if (presentation.style) { %><dt>Style</dt><dd><%= presentation.style %></dd><% } %>
          <% if (presentation.abv !== null) { %><dt>ABV</dt><dd><%= presentation.abv %>%</dd><% } %>
          <% if (presentation.ibu !== null) { %><dt>IBU</dt><dd><%= presentation.ibu %></dd><% } %>
          <% if (presentation.og !== null) { %><dt>OG</dt><dd><%= presentation.og %></dd><% } %>
          <% if (presentation.fg !== null) { %><dt>FG</dt><dd><%= presentation.fg %></dd><% } %>
          <% if (presentation.srm !== null) { %><dt>SRM</dt><dd><%= presentation.srm %></dd><% } %>
        </dl>
        <% if (presentation.description) { %><p><%= presentation.description %></p><% } %>
      </div>
    </section>
    <section aria-labelledby="story-sensory">
      <h2 id="story-sensory">Sensory profile</h2>
      <% if (it.sensoryRadar) { const radar = it.sensoryRadar; %>
        <div class="story-sensory-layout">
          <figure>
            <svg class="sensory-radar" viewBox="0 0 360 360" role="img" aria-labelledby="sensory-radar-title sensory-radar-description">
              <title id="sensory-radar-title">Sensory profile for <%= story.title %></title>
              <desc id="sensory-radar-description"><%= radar.description %></desc>
              <% for (const gridPath of radar.gridPaths) { %><path class="sensory-radar-grid" d="<%= gridPath %>" /><% } %>
              <% for (const axis of radar.axes) { %><path class="sensory-radar-axis" d="<%= axis.axisPath %>" /><text class="sensory-radar-label" x="<%= axis.labelX %>" y="<%= axis.labelY %>"><%= axis.label %></text><% if (axis.valuePoint) { const [x, y] = axis.valuePoint.split(" "); %><circle class="sensory-radar-point" cx="<%= x %>" cy="<%= y %>" r="4" /><% } %><% } %>
              <% if (radar.dataPath) { %><path class="sensory-radar-data" d="<%= radar.dataPath %>" /><% } %>
            </svg>
            <figcaption><%= radar.description %> Values are shown below with their source.</figcaption>
          </figure>
          <dl class="sensory-values">
            <% for (const axis of radar.axes) { %><div><dt><%= axis.label %></dt><dd><% if (axis.value === null) { %>Unavailable<% } else { %><%= axis.value %> / 5<% } %> · <%= axis.source %><% if (axis.confidence) { %> · <%= axis.confidence %> confidence<% } %></dd></div><% } %>
          </dl>
        </div>
      <% } else { %><p>Sensory profile unavailable.</p><% } %>
    </section>
    <section aria-labelledby="story-recipes">
      <h2 id="story-recipes">Recipe</h2>
      <% if (!story.recipes) { %><p>Recipe unavailable.</p><% } else if (!story.recipes.custom && story.recipes.sources.length === 0) { %><p>No recipe details are available.</p><% } else { %>
        <% if (story.recipes.custom) { const recipe = story.recipes.custom; %>
          <article><h3>Custom recipe</h3><% if (recipe.notes) { %><p><%= recipe.notes %></p><% } %><% if (recipe.ingredients.length > 0) { %><h4>Ingredients</h4><ul class="story-recipe-list"><% for (const ingredient of recipe.ingredients) { %><li><%= ingredient.name %><% if (ingredient.amount !== null) { %> — <%= ingredient.amount %><% } %><% if (ingredient.unit) { %> <%= ingredient.unit %><% } %><% if (ingredient.note) { %> (<%= ingredient.note %>)<% } %></li><% } %></ul><% } %><% if (recipe.steps.length > 0) { %><h4>Steps</h4><ol class="story-recipe-steps"><% for (const step of recipe.steps) { %><li><%= step.name || step.text %><% if (step.temperatureC !== null) { %> · <%= step.temperatureC %> °C<% } %><% if (step.timeMinutes !== null) { %> · <%= step.timeMinutes %> min<% } %><% if (step.note) { %> — <%= step.note %><% } %></li><% } %></ol><% } %></article>
        <% } %>
        <% for (const recipe of story.recipes.sources) { %><article><h3><%= recipe.provenance?.label || "Source recipe" %></h3><p><%= recipe.status %></p><% if (recipe.notes) { %><p><%= recipe.notes %></p><% } %><% if (recipe.ingredients.length > 0) { %><ul class="story-recipe-list"><% for (const ingredient of recipe.ingredients) { %><li><%= ingredient.name %><% if (ingredient.amount !== null) { %> — <%= ingredient.amount %><% } %><% if (ingredient.unit) { %> <%= ingredient.unit %><% } %></li><% } %></ul><% } %></article><% } %>
      <% } %>
    </section>
    <% if (it.isAdmin === true) { %>
      <section class="story-operations" aria-labelledby="story-fill">
        <h2 id="story-fill">Current fill</h2>
        <div class="fill-summary">
          <dl>
            <% if (current.fillDate) { %><dt>Filled</dt><dd><%= current.fillDate %></dd><% } %>
            <% if (current.assignedAt) { %><dt>Assigned</dt><dd><%= current.assignedAt %></dd><% } %>
            <% if (current.fillPercent !== null) { %><dt>Remaining</dt><dd><%= current.fillPercent %>%</dd><% } %>
            <% if (current.remainingVolumeMl !== null && current.capacityMl !== null) { %><dt>Volume</dt><dd data-field="volume"><span data-unit="metric"><%= it.volume(current.remainingVolumeMl, "metric") %> / <%= it.volume(current.capacityMl, "metric") %></span><span data-unit="us"><%= it.volume(current.remainingVolumeMl, "us") %> / <%= it.volume(current.capacityMl, "us") %></span></dd><% } %>
            <% if (current.servingsRemaining !== null) { %><dt>Servings</dt><dd><%= current.servingsRemaining %></dd><% } %>
            <% if (current.daysRemaining !== null) { %><dt>Forecast</dt><dd><%= current.daysRemaining %> days</dd><% } %>
            <% if (current.temperatureC !== null) { %><dt>Serving temperature</dt><dd class="temperature" data-field="temperature"><span data-unit="metric"><%= it.temperature(current.temperatureC, "metric") %></span><span data-unit="us"><%= it.temperature(current.temperatureC, "us") %></span></dd><% } %>
          </dl>
          <%~ include("/partials/fill-graphic", { tap: { id: it.tapId, tapNumber: story.tapNumber, title: story.title, accessibleLabel: story.accessibleLabel, graphic: story.vessel.graphic, displayColor: story.vessel.displayColor, fillPercent: current.fillPercent } }) %>
        </div>
        <% if (current.waitingForMeasurement) { %><p>Waiting for a current measurement.</p><% } %>
      </section>
      <% if (story.history) { %><section class="story-operations" aria-labelledby="story-history"><h2 id="story-history">Fill history</h2><% if (story.history.length === 0) { %><p>No pour history recorded.</p><% } else { %><ol><% for (const item of story.history) { %><li data-field="history-volume"><span data-unit="metric"><%= it.volume(item.volumeMl, "metric") %></span><span data-unit="us"><%= it.volume(item.volumeMl, "us") %></span> · <%= item.startedAt %> to <%= item.completedAt %></li><% } %></ol><% } %></section><% } %>
    <% } %>
    <div data-story data-tap-id="<%= it.tapId %>" data-sse-path="<%= it.ssePath %>"></div>
  <% } %>
</main>
<% if (it.story) { %><script type="module" src="/assets/js/story.js"></script><% } %>
