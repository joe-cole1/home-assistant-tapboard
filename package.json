{
  "name": "home-assistant-tapboard",
  "version": "3.2.0",
  "description": "Containerized Home Assistant Tapboard with real-time WebSocket sync and SQLite analytics",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "db:backup": "node scripts/db-maintenance.js backup",
    "db:verify": "node scripts/db-maintenance.js verify",
    "db:restore": "node scripts/db-maintenance.js restore",
    "db:prune-pours": "node scripts/db-maintenance.js prune-pours"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.0",
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "linkedom": "^0.18.13"
  }
}
